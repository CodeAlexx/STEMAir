      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkLabel"><property name="label">Backing-model rebalance (0–1)</property></object></child>
       <child><object class="GtkEntry" id="vocal_amount"><property name="text">0.9</property><property name="width-chars">8</property></object></child>
      </object></child>
      <child><object class="GtkLabel"><property name="label">0 sends primary vocals directly to the splitter. A positive amount adds reduced instrumental input.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkCheckButton" id="vocal_mixes"><property name="label">Save instrumental with lead and backing vocals</property></object></child>
      <child><object class="GtkBox"><property name="spacing">16</property>
       <child><object class="GtkCheckButton" id="vocal_mix_only"><property name="label">Only instrumental outputs</property></object></child>
       <child><object class="GtkCheckButton" id="vocal_save_only"><property name="label">Only vocal outputs</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">16</property>
       <child><object class="GtkDropDown" id="vocal_outputs"><property name="model">secondary_output_choices</property><property name="width-request">250</property></object></child>
       <child><object class="GtkCheckButton" id="vocal_normalize"><property name="label">Normalize final peaks above 1</property></object></child>
       <child><object class="GtkCheckButton" id="vocal_keep"><property name="label">Keep raw member stems</property></object></child>
      </object></child>
      <child><object class="GtkLabel"><property name="label">The chain uses primary vocals after secondary blending. Rebalance and mixed outputs also need the primary instrumental stem.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkButton" id="vocal_run"><property name="label">Process vocal chain</property><property name="halign">start</property><style><class name="suggested-action"/></style></object></child>
      <child><object class="GtkLabel"><property name="label">The Recording queue can process this chain with Process pending with secondary models.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
     </object></property>
    </object></child>
    <child><object class="GtkNotebookPage">
     <property name="tab"><object class="GtkLabel"><property name="label">Listen &amp; results</property></object></property>
     <property name="child"><object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property>
      <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property>
       <child><object class="GtkLabel"><property name="label">Listen to recordings and exported sources.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
       <child><object class="GtkBox"><property name="spacing">10</property>
        <child><object class="GtkButton" id="audio_input"><property name="label">Play recording</property></object></child>
        <child><object class="GtkButton" id="audio_choose"><property name="label">Choose audio…</property><property name="tooltip-text">Choose audio to listen to (Ctrl+Shift+U).</property></object></child>
        <child><object class="GtkButton" id="audio_external"><property name="label">Open in default app</property></object></child>
       </object></child>
       <child><object class="GtkEntry" id="audio_file"><property name="placeholder-text">Selected audio path</property><property name="tooltip-text">Focus the audio path with Ctrl+Shift+I.</property><property name="hexpand">true</property></object></child>
       <child><object class="GtkVideo" id="audio_player"><property name="height-request">120</property><property name="hexpand">true</property></object></child>
       <child><object class="GtkBox"><property name="spacing">10</property>
        <child><object class="GtkButton" id="audio_play"><property name="label">Play selected</property></object></child>
        <child><object class="GtkButton" id="audio_pause"><property name="label">Pause</property></object></child>
        <child><object class="GtkButton" id="audio_stop"><property name="label">Stop</property></object></child>
        <child><object class="GtkCheckButton" id="audio_muted"><property name="label">Mute</property></object></child>
        <child><object class="GtkLabel"><property name="label">Volume (%)</property></object></child>
        <child><object class="GtkScale" id="audio_volume"><property name="orientation">horizontal</property><property name="adjustment">audio_volume_adjustment</property><property name="width-request">160</property><property name="digits">0</property><property name="draw-value">true</property></object></child>
       </object></child>
       <child><object class="GtkLabel" id="audio_status"><property name="label">No audio loaded</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
       <child><object class="GtkScale" id="audio_seek"><property name="orientation">horizontal</property><property name="adjustment">audio_seek_adjustment</property><property name="draw-value">false</property><property name="sensitive">false</property></object></child>
       <child><object class="GtkSeparator"/></child>
       <child><object class="GtkLabel"><property name="label">Results folder</property><property name="xalign">0</property></object></child>
       <child><object class="GtkEntry" id="audio_folder"><property name="editable">false</property><property name="hexpand">true</property></object></child>
       <child><object class="GtkBox"><property name="spacing">10</property>
        <child><object class="GtkButton" id="audio_refresh"><property name="label">Use output folder</property></object></child>
        <child><object class="GtkButton" id="audio_choose_folder"><property name="label">Choose folder…</property></object></child>
        <child><object class="GtkButton" id="audio_open_folder"><property name="label">Open folder</property></object></child>
        <child><object class="GtkButton" id="audio_reveal"><property name="label">Open file folder</property></object></child>
       </object></child>
       <child><object class="GtkScrolledWindow"><property name="height-request">170</property><property name="vexpand">true</property>
        <child><object class="GtkListBox" id="audio_results"><style><class name="audio-results"/></style><property name="selection-mode">single</property></object></child>
       </object></child>
       <child><object class="GtkLabel" id="audio_results_status"><property name="label">Completed jobs appear here. Choose a folder to browse existing results.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      </object></child>
     </object></property>
    </object></child>
    <child><object class="GtkNotebookPage">
     <property name="tab"><object class="GtkLabel"><property name="label">Models</property></object></property>
     <property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-top">16</property>
      <child><object class="GtkLabel"><property name="label">Choose a supported model. Browsing the catalog stays offline; only Download connects to the model host.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkEntry" id="catalog_directory"><property name="hexpand">true</property><property name="placeholder-text">Model folder (absolute path)</property></object></child>
       <child><object class="GtkButton" id="catalog_choose"><property name="label">Model folder…</property></object></child>
       <child><object class="GtkButton" id="catalog_refresh"><property name="label">Refresh</property></object></child>
      </object></child>
      <child><object class="GtkScrolledWindow"><property name="height-request">180</property><property name="vexpand">true</property>
       <child><object class="GtkListBox" id="catalog_profiles"><style><class name="audio-results"/></style><property name="selection-mode">single</property></object></child>
      </object></child>
      <child><object class="GtkLabel" id="catalog_details"><property name="label">Select an admitted profile</property><property name="xalign">0</property><property name="wrap">true</property><property name="selectable">true</property></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkButton" id="catalog_use"><property name="label">Use existing</property></object></child>
       <child><object class="GtkButton" id="catalog_verify"><property name="label">Verify identity</property></object></child>
       <child><object class="GtkButton" id="catalog_acquire"><property name="label">Download</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkButton" id="model_edit"><property name="label">Edit parameters</property></object></child><child><object class="GtkButton" id="model_restore"><property name="label">Restore bundled defaults</property></object></child></object></child>
      <child><object class="GtkScrolledWindow" id="model_editor"><property name="visible">false</property><property name="height-request">280</property><property name="vexpand">true</property><child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property>
       <child><object class="GtkLabel" id="model_editor_identity"><property name="xalign">0</property><property name="wrap">true</property><property name="selectable">true</property></object></child>
       <child><object class="GtkLabel"><property name="label">Save and use ends the loaded-model session. Models load with these settings on the next job. Pending queues keep their accepted definitions.</property><property name="wrap">true</property><property name="xalign">0</property></object></child>
       <child><object class="GtkBox" id="model_editor_sources"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Primary stem</property></object></child><child><object class="GtkEntry" id="model_editor_source"><property name="hexpand">true</property><property name="placeholder-text">Vocals, Instrumental, Other, Bass, Drums, Guitar, Piano, Synthesizer, Strings, Woodwinds, Brass, Wind Inst</property></object></child><child><object class="GtkCheckButton" id="model_editor_custom"><property name="label">Custom</property></object></child><child><object class="GtkCheckButton" id="model_editor_inverse"><property name="label">Inverse</property></object></child><child><object class="GtkDropDown" id="model_editor_role"><property name="model">model_editor_role_choices</property><property name="tooltip-text">Role affects vocal-split target order and prevents recursive automatic vocal splitting. Other primaries use Standard.</property></object></child><child><object class="GtkLabel"><property name="label">Backing rebalance</property></object></child><child><object class="GtkDropDown" id="model_editor_rebalance"><property name="model">model_editor_rebalance_choices</property></object></child></object></child>
       <child><object class="GtkBox" id="model_editor_parameters_row"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Native parameter configuration</property></object></child><child><object class="GtkEntry" id="model_editor_parameters"><property name="hexpand">true</property></object></child><child><object class="GtkButton" id="model_editor_choose"><property name="label">Choose…</property></object></child></object></child>
       <child><object class="GtkBox" id="model_editor_exchange"><property name="orientation">vertical</property><property name="spacing">8</property>
        <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">FFT size</property></object></child><child><object class="GtkEntry" id="model_editor_fft"><property name="hexpand">true</property></object></child></object></child>
        <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Frequency bins</property></object></child><child><object class="GtkEntry" id="model_editor_bins"><property name="hexpand">true</property></object></child></object></child>
        <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Frame exponent (frames = 2^exponent)</property></object></child><child><object class="GtkEntry" id="model_editor_frames"><property name="hexpand">true</property></object></child></object></child>
        <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkLabel"><property name="label">Compensation</property></object></child><child><object class="GtkEntry" id="model_editor_compensation"><property name="hexpand">true</property></object></child></object></child>
       </object></child>
       <child><object class="GtkBox" id="model_editor_mask"><property name="spacing">8</property><child><object class="GtkCheckButton" id="model_editor_recurrent"><property name="label">Recurrent architecture</property></object></child>
        <child><object class="GtkLabel"><property name="label">Network width</property></object></child><child><object class="GtkEntry" id="model_editor_channels"><property name="width-chars">6</property></object></child>
        <child><object class="GtkLabel"><property name="label">Recurrent width</property></object></child><child><object class="GtkEntry" id="model_editor_recurrent_width"><property name="width-chars">6</property></object></child>
       </object></child>
       <child><object class="GtkLabel" id="model_editor_status"><property name="wrap">true</property><property name="xalign">0</property><property name="selectable">true</property></object></child>
       <child><object class="GtkBox"><property name="spacing">8</property><child><object class="GtkButton" id="model_editor_validate"><property name="label">Validate</property></object></child><child><object class="GtkButton" id="model_editor_save"><property name="label">Save and use</property></object></child><child><object class="GtkButton" id="model_editor_reset"><property name="label">Reset draft to source defaults</property></object></child><child><object class="GtkButton" id="model_editor_cancel"><property name="label">Cancel editing</property></object></child></object></child>
      </object></child></object></child>
      <child><object class="GtkLabel" id="catalog_status"><property name="label">Use existing verifies the pinned file before choosing it. Verify checks identity without changing the chosen model. Download verifies and selects only on success.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkLabel"><property name="label">Cancel waits for the current network read or identity check. Existing files and foreign download stages are preserved. A retained stage is reported for manual review.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
     </object></property>
    </object></child>
   </object></child>
   <child><object class="GtkLabel" id="status"><property name="label">Ready</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property><property name="halign">end</property>
    <child><object class="GtkButton" id="session_save"><property name="label">Save session as…</property><property name="tooltip-text">Save settings, model assignments, pending inputs and file references to a new preset.</property></object></child>
    <child><object class="GtkButton" id="session_open"><property name="label">Open session…</property><property name="tooltip-text">Restore a saved session without starting processing.</property></object></child>
    <child><object class="GtkButton" id="preferences_reset"><property name="label">Restore defaults</property><property name="tooltip-text">Restore and save default settings (Ctrl+Alt+Shift+R).</property></object></child>
    <child><object class="GtkButton" id="session_rename"><property name="label">Rename session…</property></object></child>
    <child><object class="GtkButton" id="session_delete"><property name="label">Delete session…</property></object></child>
    <child><object class="GtkButton" id="preferences_save"><property name="label">Save preferences</property><property name="tooltip-text">Save current settings (Ctrl+Alt+Shift+S).</property></object></child>
    <child><object class="GtkButton" id="cancel"><property name="label">Cancel</property><property name="sensitive">false</property></object></child>
   </object></child>
  </object></child>
 </object>
</interface>
