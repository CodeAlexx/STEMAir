      </object></child>
      <child><object class="GtkLabel"><property name="label">Each recording gets a numbered folder inside the output folder above. Completed recordings leave this pending list; retry keeps the remaining recording numbers.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkCheckButton" id="queue_continue"><property name="label">Continue after a separation error (unreadable recordings are always skipped)</property></object></child>
