   </object></child>
   <child><object class="GtkSeparator"/></child>
   <child><object class="GtkLabel"><property name="label">Combine sums all listed inputs. Paired tools use exactly two inputs in the listed order. Shorter inputs are padded with silence; these tools preserve peaks above 1.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkButton" id="tool_combine"><property name="label">Combine audio</property></object></child>
