   </object></child>
   <child><object class="GtkLabel"><property name="label">Apply to all queued recordings, or the recording selected above when the queue is empty. Positive shifts raise pitch and shorten duration; negative shifts lengthen it. Uses the normalization option above.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkSeparator"/></child>
