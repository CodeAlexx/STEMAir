<?xml version="1.0" encoding="UTF-8"?>
<interface>
 <requires lib="gtk" version="4.10"/>
 <object class="GtkStringList" id="room_target_choices"><items><item>Vocals</item><item>Lead vocals</item><item>Backing vocals</item><item>All vocal outputs</item></items></object>
 <object class="GtkStringList" id="mask_tta_choices"><items><item>Model default</item><item>TTA off</item><item>TTA on</item></items></object>
 <object class="GtkStringList" id="model_editor_role_choices"><items><item>Standard model</item><item>Lead vocal model</item><item>Backing vocal model</item></items></object>
 <object class="GtkStringList" id="model_editor_rebalance_choices"><items><item>0.0</item><item>0.1</item><item>0.2</item><item>0.3</item><item>0.4</item><item>0.5</item><item>0.6</item><item>0.7</item><item>0.8</item><item>0.9</item></items></object>
 <object class="GtkStringList" id="model_output_choices"><items><item>Common stems</item><item>Vocals and instrumental</item></items></object>
 <object class="GtkStringList" id="model_method_choices"><items><item>Average</item><item>Minimum magnitude</item><item>Maximum magnitude</item></items></object>
 <object class="GtkStringList" id="secondary_target_choices"><items><item>Vocals</item><item>Instrumental</item><item>Bass</item><item>Drums</item><item>Other</item></items></object>
 <object class="GtkStringList" id="secondary_output_choices"><items><item>All primary stems</item><item>Vocals and instrumental</item><item>Bass and complement</item><item>Drums and complement</item><item>Other and complement</item></items></object>
 <object class="GtkStringList" id="complement_choices"><items><item>Use model estimates</item><item>Spectral complement</item></items></object>
 <object class="GtkStringList" id="alignment_polarity_choices"><items><item>Keep second</item><item>Invert second</item><item>Automatic</item></items></object>
 <object class="GtkStringList" id="alignment_window_choices"><items><item>0.0625 seconds</item><item>0.125 seconds</item><item>0.25 seconds</item><item>0.5 seconds</item><item>Low: two windows</item><item>Medium: three windows</item><item>High: four windows</item><item>0.75 seconds</item><item>1 second</item><item>2 seconds</item><item>None: whole-track alignment</item></items></object>
 <object class="GtkStringList" id="alignment_intro_choices"><items><item>Default intro</item><item>One eighth</item><item>One sixth</item><item>One quarter</item><item>One half</item><item>Two intros</item><item>Three intros</item><item>Five intros</item></items></object>
 <object class="GtkStringList" id="alignment_gain_choices"><items><item>Unity</item><item>Low</item><item>Medium</item><item>High</item><item>Very high</item></items></object>
 <object class="GtkStringList" id="alignment_phase_choices"><items><item>Unchanged</item><item>Try opposite polarity</item><item>90 degree steps</item><item>45 degree steps</item><item>20 degree steps</item><item>10 degree steps</item><item>1 degree steps</item></items></object>
 <object class="GtkStringList" id="alignment_initial_polarity_choices"><items><item>Automatic</item><item>Positive</item><item>Negative</item><item>Native</item></items></object>
 <object class="GtkStringList" id="wav_subtype_choices"><items><item>Unsigned 8-bit</item><item>Signed 16-bit</item><item>Signed 24-bit</item><item>Signed 32-bit</item><item>Float 32-bit</item><item>Float 64-bit</item></items></object>
 <object class="GtkStringList" id="container_choices"><items><item>WAV</item><item>FLAC</item><item>MP3</item></items></object>
 <object class="GtkStringList" id="audio_budget_choices"><items><item>256 MiB</item><item>512 MiB</item><item>1 GiB</item><item>2 GiB</item></items></object>
 <object class="GtkStringList" id="mp3_bitrate_choices"><items><item>96 kbps</item><item>128 kbps</item><item>160 kbps</item><item>224 kbps</item><item>256 kbps</item><item>320 kbps</item></items></object>
 <object class="GtkAdjustment" id="audio_volume_adjustment"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">5</property><property name="page-increment">10</property><property name="value">75</property></object>
 <object class="GtkAdjustment" id="audio_seek_adjustment"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">1</property><property name="page-increment">10</property></object>
 <object class="GtkWindow" id="window">
  <property name="title">STEMAir</property>
  <property name="default-width">1000</property><property name="default-height">1100</property>
  <child><object class="GtkBox">
   <property name="orientation">vertical</property><property name="spacing">8</property>
   <property name="margin-start">32</property><property name="margin-end">32</property>
   <property name="margin-top">20</property><property name="margin-bottom">20</property>
   <child><object class="GtkLabel"><property name="label">STEMAir</property><property name="xalign">0</property><style><class name="title-1"/></style></object></child>
   <child><object class="GtkLabel"><property name="label">Separate sources and clean up audio.</property><property name="xalign">0</property></object></child>
   <child><object class="GtkSeparator"/></child>
   <child><object class="GtkLabel"><property name="label">MODEL</property><property name="xalign">0</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkEntry" id="settings"><property name="hexpand">true</property><property name="placeholder-text">Model configuration</property></object></child>
    <child><object class="GtkButton" id="choose_settings"><property name="label">Configuration…</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkEntry" id="checkpoint"><property name="hexpand">true</property><property name="placeholder-text">Model checkpoint</property></object></child>
    <child><object class="GtkButton" id="choose_checkpoint"><property name="label">Weights…</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">16</property>
    <child><object class="GtkCheckButton" id="gpu"><property name="label">Use GPU</property><property name="active">false</property></object></child>
    <child><object class="GtkLabel"><property name="label">GPU index</property></object></child>
    <child><object class="GtkEntry" id="gpu_index"><property name="text">0</property><property name="width-chars">4</property><property name="tooltip-text">Zero-based device index. Main models and optional learned cleanup use the same selected device.</property></object></child>
    <child><object class="GtkCheckButton" id="high_band"><property name="label">Reconstruct high frequencies</property><property name="tooltip-text">Use high-frequency reconstruction with compatible separation models.</property></object></child>
    <child><object class="GtkButton" id="reload"><property name="label">Release loaded models</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="cleanup_enabled"><property name="label">Reduce mask artifacts</property><property name="tooltip-text">Clean sustained high-confidence mask regions after prediction. Applies to compatible mask models without reloading weights.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Threshold</property></object></child>
    <child><object class="GtkEntry" id="cleanup_threshold"><property name="text">0.2</property><property name="width-chars">10</property><property name="sensitive">false</property><property name="tooltip-text">0 to below 1, with up to six decimal places. Default 0.2.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Mask prediction</property></object></child>
    <child><object class="GtkDropDown" id="mask_tta"><property name="model">mask_tta_choices</property><property name="tooltip-text">Average an additional shifted prediction with compatible mask models.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Window</property></object></child>
    <child><object class="GtkEntry" id="mask_window"><property name="text">Default</property><property name="width-chars">8</property><property name="tooltip-text">Default uses the model setting. Otherwise enter 288 to 4096 frames in steps of 32.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Aggression</property></object></child>
    <child><object class="GtkEntry" id="mask_aggression"><property name="text">Default</property><property name="width-chars">8</property><property name="tooltip-text">Default uses the model setting. Otherwise enter a whole number from 0 to 50.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="inference_pitch"><property name="label">Pitch during inference</property><property name="tooltip-text">Shift compatible model inputs and restore the original pitch after separation.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Semitones</property></object></child>
    <child><object class="GtkEntry" id="inference_semitones"><property name="text">0</property><property name="width-chars">8</property><property name="tooltip-text">A decimal from -20 to 20.</property></object></child>
    <child><object class="GtkCheckButton" id="match_frequency"><property name="label">Match mixture frequencies</property><property name="tooltip-text">Use the compatible model's frequency range for spectral subtraction.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="recording_override"><property name="label">Recording inference</property><property name="tooltip-text">Use request settings on the selected CPU or GPU for compatible waveform, temporal, hybrid and attention models. Otherwise inherit the profile.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Shifts</property></object></child>
    <child><object class="GtkEntry" id="recording_shifts"><property name="text">2</property><property name="width-chars">6</property><property name="tooltip-text">A nonnegative whole count. Zero disables random time shifts.</property></object></child>
    <child><object class="GtkCheckButton" id="recording_split"><property name="label">Split recording</property><property name="active">true</property></object></child>
    <child><object class="GtkLabel"><property name="label">Overlap</property></object></child>
    <child><object class="GtkEntry" id="recording_overlap"><property name="text">0.25</property><property name="width-chars">7</property><property name="tooltip-text">Zero to below one. The first generation uses isolated chunks.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Segment</property></object></child>
    <child><object class="GtkEntry" id="recording_segment"><property name="text">Default</property><property name="width-chars">8</property><property name="tooltip-text">Default or 1 to 200 seconds. Individual checkpoints retain their model's segment duration.</property></object></child>
    <child><object class="GtkLabel"><property name="label">Replay seed</property></object></child>
    <child><object class="GtkEntry" id="recording_seed"><property name="text">Random</property><property name="width-chars">14</property><property name="tooltip-text">Random accepts one new seed per request; a nonnegative integer reproduces its shift sequence.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="noise_reduction"><property name="label">Reduce noise</property><property name="tooltip-text">Apply the selected noise model before compatible spectral separation.</property></object></child>
    <child><object class="GtkEntry" id="noise_checkpoint"><property name="hexpand">true</property><property name="placeholder-text">Noise reduction weights</property></object></child>
    <child><object class="GtkButton" id="choose_noise_checkpoint"><property name="label">Weights…</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="room_reduction"><property name="label">Reduce room sound</property><property name="tooltip-text">Save additional room-reduced vocal outputs with the selected model.</property></object></child>
    <child><object class="GtkDropDown" id="room_targets"><property name="model">room_target_choices</property></object></child>
    <child><object class="GtkEntry" id="room_checkpoint"><property name="hexpand">true</property><property name="placeholder-text">Room reduction weights</property></object></child>
    <child><object class="GtkButton" id="choose_room_checkpoint"><property name="label">Weights…</property></object></child>
   </object></child>
   <child><object class="GtkLabel"><property name="label">RECORDING</property><property name="xalign">0</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkEntry" id="input"><property name="hexpand">true</property><property name="placeholder-text">Audio file (WAV, FLAC, MP3…)</property></object></child>
    <child><object class="GtkButton" id="choose_input"><property name="label">Browse…</property></object></child>
   </object></child>
   <child><object class="GtkLabel"><property name="label">SAVE SOURCES TO</property><property name="xalign">0</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkEntry" id="output"><property name="hexpand">true</property><property name="placeholder-text">An existing output folder</property></object></child>
    <child><object class="GtkButton" id="choose_output"><property name="label">Folder…</property></object></child>
   </object></child>
   <child><object class="GtkSeparator"/></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Format</property></object></child>
    <child><object class="GtkDropDown" id="output_container"><property name="model">container_choices</property><property name="width-request">100</property></object></child>
    <child><object class="GtkLabel"><property name="label">Sample format</property><property name="tooltip-text">WAV precision before optional compression. Float64 retains the F32 processing precision.</property></object></child>
    <child><object class="GtkDropDown" id="export_subtype"><property name="model">wav_subtype_choices</property><property name="selected">4</property><property name="width-request">180</property></object></child>
    <child><object class="GtkLabel"><property name="label">MP3</property></object></child>
    <child><object class="GtkDropDown" id="mp3_bitrate"><property name="model">mp3_bitrate_choices</property><property name="selected">5</property><property name="width-request">110</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Audio codec tools</property></object></child>
    <child><object class="GtkEntry" id="codec_directory"><property name="hexpand">true</property><property name="placeholder-text">Audio codec tools for compressed input, resampling and FLAC / MP3 output</property></object></child>
    <child><object class="GtkButton" id="choose_codec_directory"><property name="label">Tools folder…</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="naming_append_model"><property name="label">Model name in filenames</property></object></child>
    <child><object class="GtkCheckButton" id="naming_model_folder"><property name="label">Model subfolders</property></object></child>
    <child><object class="GtkCheckButton" id="naming_testing"><property name="label">Timestamp filenames</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="naming_append_ensemble"><property name="label">Ensemble name in filenames</property></object></child>
    <child><object class="GtkEntry" id="naming_ensemble_label"><property name="hexpand">true</property><property name="placeholder-text">Ensembled (default)</property><property name="tooltip-text">Optional ensemble label. Spaces become underscores in filenames.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Audio buffer limit</property><property name="tooltip-text">Decoded audio per recording or source. Models and processing need additional memory.</property></object></child>
    <child><object class="GtkDropDown" id="audio_budget"><property name="model">audio_budget_choices</property><property name="selected">1</property><property name="width-request">120</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkCheckButton" id="processing_sample"><property name="label">Process a sample</property><property name="tooltip-text">Use one temporary sample for model separation and pitch or tempo changes. Manual blending and paired alignment use the full recordings.</property></object></child>
    <child><object class="GtkEntry" id="processing_sample_seconds"><property name="text">30</property><property name="width-chars">5</property><property name="tooltip-text">Whole seconds from 5 to 120. Uses the same duration and decoder as Create selected samples in Audio tools.</property></object></child>
    <child><object class="GtkLabel"><property name="label">seconds (5–120)</property></object></child>
   </object></child>
   <child><object class="GtkNotebook" id="workflow"><property name="vexpand">true</property>
    <child><object class="GtkNotebookPage">
     <property name="tab"><object class="GtkLabel"><property name="label">Single model</property></object></property>
     <property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-top">16</property>
      <child><object class="GtkLabel"><property name="label">Separate the recording with the model selected above.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkLabel"><property name="label">Loaded models stay available for further recordings until released.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkLabel"><property name="label">Outputs</property></object></child>
       <child><object class="GtkDropDown" id="single_outputs"><property name="model">secondary_output_choices</property><property name="width-request">250</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkLabel"><property name="label">Complement</property></object></child>
       <child><object class="GtkDropDown" id="single_complement"><property name="model">complement_choices</property><property name="width-request">250</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">16</property>
       <child><object class="GtkCheckButton" id="single_normalize"><property name="label">Normalize peaks above 1</property></object></child>
       <child><object class="GtkCheckButton" id="single_keep"><property name="label">Keep model estimates</property></object></child>
      </object></child>
      <child><object class="GtkLabel"><property name="label">Complement choices apply to derived sources. Spectral outputs may end earlier on their analysis frame grid.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkButton" id="separate"><property name="label">Separate audio</property><property name="halign">start</property><style><class name="suggested-action"/></style></object></child>
     </object></property>
    </object></child>
    <child><object class="GtkNotebookPage">
     <property name="tab"><object class="GtkLabel"><property name="label">Model ensemble</property></object></property>
     <property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-top">16</property>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkButton" id="model_add"><property name="label">Add selected model</property></object></child>
       <child><object class="GtkButton" id="model_remove"><property name="label">Remove last</property></object></child>
       <child><object class="GtkButton" id="model_clear"><property name="label">Clear models</property></object></child>
      </object></child>
      <child><object class="GtkLabel" id="model_inputs"><property name="label">Choose a configuration and weights above, then add at least two models.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkButton" id="model_processing_add"><property name="label">Attach processing to last member…</property></object></child>
       <child><object class="GtkButton" id="model_processing_clear"><property name="label">Clear last member processing</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkLabel"><property name="label">Outputs</property></object></child>
       <child><object class="GtkDropDown" id="model_outputs"><property name="model">model_output_choices</property><property name="width-request">250</property></object></child>
       <child><object class="GtkLabel"><property name="label">Stems / vocals</property></object></child>
       <child><object class="GtkDropDown" id="model_primary"><property name="model">model_method_choices</property><property name="width-request">220</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkLabel"><property name="label">Instrumental method (paired outputs)</property></object></child>
       <child><object class="GtkDropDown" id="model_secondary"><property name="model">model_method_choices</property><property name="width-request">220</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">16</property>
       <child><object class="GtkCheckButton" id="model_wave"><property name="label">Compare waveforms</property></object></child>
       <child><object class="GtkCheckButton" id="model_normalize"><property name="label">Normalize peaks above 1</property></object></child>
       <child><object class="GtkCheckButton" id="model_keep"><property name="label">Keep member stems</property></object></child>
      </object></child>
      <child><object class="GtkCheckButton" id="model_residual"><property name="label">Subtract vocals from recording for instrumental (otherwise sum other stems)</property></object></child>
      <child><object class="GtkCheckButton" id="model_spectral"><property name="label">Use spectral complements</property></object></child>
      <child><object class="GtkButton" id="model_run"><property name="label">Separate and ensemble</property><property name="halign">start</property><style><class name="suggested-action"/></style></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkButton" id="model_preset_save"><property name="label">Save ensemble preset…</property></object></child>
       <child><object class="GtkButton" id="model_preset_open"><property name="label">Open ensemble preset…</property></object></child>
       <child><object class="GtkButton" id="model_preset_rename"><property name="label">Rename preset…</property></object></child>
       <child><object class="GtkButton" id="model_preset_delete"><property name="label">Delete preset…</property></object></child>
      </object></child>
     </object></property>
    </object></child>
    <child><object class="GtkNotebookPage">
     <property name="tab"><object class="GtkLabel"><property name="label">Audio tools</property></object></property>
     <property name="child"><object class="GtkScrolledWindow"><property name="vexpand">true</property><property name="hscrollbar-policy">never</property>
      <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-top">16</property>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkButton" id="ensemble_add"><property name="label">Add audio inputs…</property></object></child>
    <child><object class="GtkButton" id="ensemble_clear"><property name="label">Clear all inputs</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkButton" id="ensemble_current"><property name="label">Add current recording</property></object></child>
    <child><object class="GtkButton" id="ensemble_remove"><property name="label">Remove last</property></object></child>
    <child><object class="GtkButton" id="ensemble_swap"><property name="label">Swap pair</property></object></child>
   </object></child>
   <child><object class="GtkLabel" id="ensemble_inputs"><property name="label">Choose at least two matching source recordings.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkScrolledWindow"><property name="min-content-height">160</property><property name="hscrollbar-policy">never</property>
    <child><object class="GtkListBox" id="ensemble_rows"><property name="selection-mode">multiple</property><style><class name="audio-results"/></style></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkButton" id="ensemble_remove_selected"><property name="label">Remove selected inputs</property></object></child>
    <child><object class="GtkButton" id="ensemble_keep_selected"><property name="label">Keep selected inputs only</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkButton" id="ensemble_open_file"><property name="label">Open selected recording</property></object></child>
    <child><object class="GtkButton" id="ensemble_open_folder"><property name="label">Open recording folder</property></object></child>
    <child><object class="GtkButton" id="ensemble_verify"><property name="label">Verify all inputs</property></object></child>
   </object></child>
   <child><object class="GtkCheckButton" id="ensemble_activation_file"><property name="label">Enter or double-click opens the recording</property><property name="tooltip-text">When off, open the recording folder. Applies to both input lists for this app session.</property></object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Sample seconds (5–120)</property></object></child>
    <child><object class="GtkEntry" id="ensemble_sample_seconds"><property name="width-chars">5</property><property name="text">30</property></object></child>
    <child><object class="GtkButton" id="ensemble_sample"><property name="label">Create selected samples</property><property name="tooltip-text">Export 44.1 kHz PCM16 WAV samples to the output folder.</property></object></child>
   </object></child>
   <child><object class="GtkBox"><property name="spacing">12</property>
    <child><object class="GtkLabel"><property name="label">Sample decoder</property></object></child>
