      <child><object class="GtkLabel"><property name="label">Add the primary model first, then a lead/backing splitter. This model list and output options are shared with Secondary models.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkBox"><property name="spacing">12</property>
       <child><object class="GtkButton" id="vocal_model_add"><property name="label">Add selected model</property></object></child>
