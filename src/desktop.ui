    <child><object class="GtkButton" id="tool_mix"><property name="label">Mix pair</property></object></child>
    <child><object class="GtkButton" id="tool_reduce"><property name="label">Reduce background</property></object></child>
   </object></child>
   <child><object class="GtkLabel"><property name="label">Mix: first × amount + second × (1 − amount). Reduce: first (background) × (1 − amount) + second (vocal).</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkButton" id="tool_spectral"><property name="label">Spectral complement</property></object></child>
   <child><object class="GtkLabel"><property name="label">Use the mixture first and its estimated stem second. The spectral complement follows the shorter input on a 1024-sample frame grid. Amount is not used.</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
   <child><object class="GtkSeparator"/></child>
