       <child><object class="GtkButton" id="queue_single"><property name="label">Process pending with selected model</property><style><class name="suggested-action"/></style></object></child>
       <child><object class="GtkButton" id="queue_ensemble"><property name="label">Process pending with model ensemble</property></object></child>
      </object></child>
