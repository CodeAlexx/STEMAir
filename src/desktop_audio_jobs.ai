module stemair.desktop_audio_jobs
import "job.ai" as job
import "queue_job.ai" as queue
import "checked_input.ai" as checked
import "recording_sample_application.ai" as sample
import "sample_processing_jobs.ai" as sampled
import "output_naming.ai" as naming
pub type RecordingAlignment=struct{work:option<job.RecordingAlignmentWork>,policy:option<checked.Options>}
pub fn run_RecordingAlignment(request:RecordingAlignment own)->job.Completed effects {alloc,fs.read,fs.write,fs.meta,gpu,process,time,env,ffi} {
 var r:RecordingAlignment=request
 let policy:option<checked.Options>=struct.replace(r,option.none(),field=policy)
 match struct.replace(r,option.none(),field=work){none=>job.Completed{retained:option.none(),ok:false,message:"Audio task payload is unavailable",queue_report:option.none()},some(work)=>match policy{
  none=>{var w:job.RecordingAlignmentWork=work
   job.Completed{retained:struct.replace(w,option.none(),field=retained),ok:false,message:"Audio input policy is unavailable",queue_report:option.none()}},
  some(options)=>job.run_recording_alignment(work,options)}}
}

pub type Time=struct{work:option<job.TimeWork>,policy:option<checked.Options>,sample:option<sample.Options>}
pub fn run_Time(request:Time own)->job.Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var r:Time=request
 let preparation:option<sample.Options>=struct.replace(r,option.none(),field=sample)
 let policy:option<checked.Options>=struct.replace(r,option.none(),field=policy)
 match struct.replace(r,option.none(),field=work){none=>job.Completed{retained:option.none(),ok:false,message:"Audio task payload is unavailable",queue_report:option.none()},some(work)=>sampled.dispatch(sampled.Payload.Time(work),policy,preparation)}
}
