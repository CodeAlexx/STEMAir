pub type Queue=struct{work:option<queue.Work>,policy:option<checked.Options>,sample:option<sample.Options>,naming_snapshot:string=""}
fn refuse_queue(work:queue.Work own,policy:option<checked.Options> own,preparation:option<sample.Options> own,problem:str)->job.Completed effects {alloc} {
 var w:queue.Work=work
 job.Completed{retained:struct.replace(w,option.none(),field=retained),ok:false,message:string.copy(problem),queue_report:option.none()}
}
pub fn run_Queue(request:Queue own)->job.Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var r:Queue=request
 let preparation:option<sample.Options>=struct.replace(r,option.none(),field=sample)
 let policy:option<checked.Options>=struct.replace(r,option.none(),field=policy)
 match struct.replace(r,option.none(),field=work){none=>job.Completed{retained:option.none(),ok:false,message:"Audio task payload is unavailable",queue_report:option.none()},some(work)=>{
 if str.len(r.naming_snapshot)>0{
  return match naming.decode_queue(r.naming_snapshot){ok(selected)=>queue.run_named(work,selected,policy,preparation),err(problem)=>refuse_queue(work,policy,preparation,problem)}
 }
 match preparation{
  none=>match policy{none=>queue.run(work),some(options)=>queue.run_checked(work,options)},
  some(selected)=>match policy{some(options)=>queue.run_sampled(work,options,selected),none=>{
   var w:queue.Work=work
   job.Completed{retained:struct.replace(w,option.none(),field=retained),ok:false,message:"Audio input policy is unavailable",queue_report:option.none()}}}}}}
}
