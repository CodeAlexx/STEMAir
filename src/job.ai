 let result:result<unit,string>=match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(e),ok(plan)=>pitch.run_with_input_to(struct.borrow(w,field=settings),w.input,w.output,w.cancel,w.progress,plan,journal,input_options)}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{retained:retained,ok:true,directory:string.copy(w.output),message:"Pitch and duration complete",queue_report:option.none()},err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()}}
