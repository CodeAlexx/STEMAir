}
pub type SecondaryWork=struct{retained:option<cache.Cache>,settings:secondary_config.Recipe,input:string,output:string,cancel:string,progress:string,use_gpu:bool,gpu_index:u32=0,application_root:string="",mask_high_band:u32=0,mask_cleanup:bool=false,mask_cleanup_threshold:f64=0.2,mask_controls:string="",learned_controls:string="",recording_controls:string="",recording_state:string="",wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
fn execute_secondary(w:ref<SecondaryWork>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Chain>>)->result<unit,string> effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 let configurations:array<string>=recording_policy.configurations<secondary_config.Model>(struct.borrow(w.settings,field=models))
 var recording:recording_context.Context=try recording_policy.resolve_sources(w.recording_controls,recording_budget(input_options),w.recording_state,configurations)
 recording.device_index=w.gpu_index
 if w.use_gpu{let _=try device_selection.available(w.gpu_index)}
 let outcome:result<unit,string>=execute_secondary_controlled(w,journal,input_options,naming_options,recording)
 w.recording_state=try recording_state.encode(recording)
 outcome
}

fn execute_secondary_controlled(w:ref<SecondaryWork>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Chain>>,recording:ref<recording_context.Context>)->result<unit,string> effects {alloc,fs.read,fs.write,fs.meta,gpu,process,time,env,ffi} {
 let _=try learned_request.decode(w.learned_controls)
 var request:mask_request.Policy=try inference_policy.resolve(w.mask_high_band,w.mask_cleanup,w.mask_cleanup_threshold,w.mask_controls)
 var plan:container.Plan=try export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes)
 let empty:bool=match w.retained{none=>true,some(_)=>false}
 if empty{w.retained=option.some(cache.empty())}
 let serialized:string=try secondary_config.Recipe_encode(struct.borrow(w,field=settings)) map_err codec.describe
 var settings:secondary_config.Recipe=try secondary_config.Recipe_decode(serialized) map_err codec.describe
 let input:string=string.copy(w.input)
 let output:string=string.copy(w.output)
 let cancel:string=string.copy(w.cancel)
 let progress:string=string.copy(w.progress)
 let use_gpu:bool=w.use_gpu
 let root:string=string.copy(w.application_root)
 let learned_raw:string=string.copy(w.learned_controls)
 var destination:string=string.copy(output)
 let outcome:result<unit,string>=match w.retained{none=>result.err("Secondary model cache is unavailable"),some(bank)=>{
  let _=try cache.select_learned(bank,learned_raw)
  var inputs:recording_sources.Set=recording_sources.empty()
  var prepared:secondary_app.Prepared=match naming_options{none=>{
   try secondary_app.prepare_typed_with_sources_to(bank,settings,input,output,cancel,plan,input_options,use_gpu,root,inputs)},some(context)=>{
   var named:secondary_app.NamedPrepared=try secondary_app.prepare_typed_named_with_sources_to(bank,settings,input,output,cancel,plan,input_options,context,use_gpu,root,inputs)
   plan=struct.replace(named,container.wav_plan(plan.working_wav),field=format)
   struct.replace(named,secondary_app.Prepared{bindings:[],plan:secondary.Plan{required:[],outputs:[]},input:[],input_path:"",directory:""},field=prepared)}}
  destination=string.copy(prepared.directory)
  let _=try if use_gpu{cache.configure_learned_gpu_on_device(bank,learned_raw,recording.device_index)}else{cache.configure_learned_cpu(bank,learned_raw)}
  if use_gpu{
   let master:audio_result.Samples=audio_result.from_single(struct.replace(prepared,[],field=input))
   var output:typed_secondary.Output=try typed_secondary_device.separate_with_policy_controlled_inputs(bank,struct.borrow(prepared,field=bindings),struct.borrow(prepared,field=plan),settings,master,secondary_resources.limits(),plan.working_wav,request,cancel,progress,recording,inputs)
   secondary_app.export_typed_to(bank,settings,prepared,output,true,cancel,progress,plan,journal)
  }else{
   let master:audio_result.Samples=audio_result.from_single(struct.replace(prepared,[],field=input))
   var output:typed_secondary.Output=try typed_secondary_cpu.separate_with_policy_controlled_inputs(bank,struct.borrow(prepared,field=bindings),struct.borrow(prepared,field=plan),settings,master,secondary_resources.limits(),plan.working_wav,request,cancel,progress,recording,inputs)
   secondary_app.export_typed_to(bank,settings,prepared,output,false,cancel,progress,plan,journal)
  }
 }}
 w.output=destination
 outcome
}
pub fn run_secondary(work:SecondaryWork own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_secondary_impl(work,option.none(),option.none())
}
pub fn run_secondary_named(work:SecondaryWork own,context:naming.Chain own,options:option<checked_input.Options> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_secondary_impl(work,options,option.some(context))
}
fn run_secondary_impl(work:SecondaryWork own,options:option<checked_input.Options> own,context:option<naming.Chain> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var w:SecondaryWork=work
 var journal:container.Journal=container.empty_journal()
 var input_options:option<checked_input.Options>=options
 var naming_options:option<naming.Chain>=context
 let result:result<unit,string>=execute_secondary(w,journal,input_options,naming_options)
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:true,directory:string.copy(w.output),message:if w.settings.vocal_split>0{"Vocal chain complete"}else{if array.len(w.settings.models)==1{"Separation complete"}else{"Secondary processing complete"}},queue_report:option.none()},err(e)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
fn run_audio_tool_impl(work:AudioToolWork own,options:option<checked_input.Options> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, process, time} {
 var w:AudioToolWork=work
 var input_options:option<checked_input.Options>=options
 var journal:container.Journal=container.empty_journal()
 let result:result<unit,string>=match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(e),ok(plan)=>audio_tools.run_with_input_to(struct.borrow(w,field=settings),w.output,w.cancel,w.progress,plan,journal,input_options)}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{retained:retained,ok:true,directory:string.copy(w.output),message:"Audio tool complete",queue_report:option.none()},err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
pub fn run_audio_tool(work:AudioToolWork own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, process, time} {
 run_audio_tool_impl(work,option.none())
}
pub fn run_audio_tool_checked(work:AudioToolWork own,options:checked_input.Options own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, process, time} {
 run_audio_tool_impl(work,option.some(options))
}
