fn recording_budget(options:ref<option<checked_input.Options>>)->u64 effects {} {match options{none=>536870912,some(value)=>value.limits.max_decoded_bytes}}
pub type Work=struct{retained:option<cache.Cache>,settings:string,checkpoint:string,input:string,output:string,cancel:string,progress:string,use_gpu:bool,gpu_index:u32=0,application_root:string="",mask_high_band:u32=0,mask_cleanup:bool=false,mask_cleanup_threshold:f64=0.2,mask_controls:string="",learned_controls:string="",recording_controls:string="",recording_state:string="",wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
pub type Completed=struct{recording_state:string="",retained:option<cache.Cache>,ok:bool,message:string,queue_report:option<queue_config.Report>,directory:string="",
 catalog_profile:string="",catalog_settings:string="",catalog_checkpoint:string="",catalog_report:string="",export_report:string="",verification_report:string="",sample_report:string="",paired_report:string="",paired_report_file:string="",paired_snapshot:string="",mastering_report:string=""}
pub type CatalogWork=struct{retained:option<cache.Cache>,request:model_selection.Request,cancel:string,progress:string}
pub fn run_catalog(work:CatalogWork own)->Completed effects {alloc,fs.read,fs.write,fs.meta,net,random,time} {
 var w:CatalogWork=work
 let options:acquisition.Options=acquisition.Options{}
 let outcome:result<model_selection.Outcome,string>=model_selection.run(struct.borrow(w,field=request),options,w.cancel,w.progress)
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 match outcome{err(problem)=>Completed{retained:retained,ok:false,queue_report:option.none(),
  message:text.concat(problem,model_selection.staging_note(struct.borrow(w,field=request)))},
 ok(value)=>{
  let report:string=match value.report{none=>"",some(r)=>match acquisition.Report_encode(r){ok(v)=>v,err(_)=>""}}
  Completed{retained:retained,ok:true,message:string.copy(value.message),queue_report:option.none(),catalog_profile:string.copy(value.profile),
   catalog_settings:string.copy(value.settings),catalog_checkpoint:string.copy(value.checkpoint),catalog_report:report}}}
}
pub type EnsembleWork=struct{retained:option<cache.Cache>,settings:ensemble_app.Settings,output:string,cancel:string,progress:string,wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
