pub type AlignmentWork=struct{retained:option<cache.Cache>,settings:alignment.Settings,first:string,second:string,output:string,cancel:string,progress:string,wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
pub type TimeWork=struct{retained:option<cache.Cache>,settings:audio_time.Settings,input:string,output:string,cancel:string,progress:string,wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
pub type RecordingAlignmentWork=struct{retained:option<cache.Cache>,settings:recording_alignment.Settings,selection:option<alignment_choices.Recipe>,first:string,second:string,output:string,cancel:string,progress:string,wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
pub fn run_recording_alignment(work:RecordingAlignmentWork own,options:checked_input.Options own)->Completed effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 var w:RecordingAlignmentWork=work
 var policy:checked_input.Options=options
 var journal:container.Journal=container.empty_journal()
 let selected:option<alignment_choices.Recipe>=struct.replace(w,option.none(),field=selection)
 let ready:result<unit,string>=match w.retained{none=>result.ok(()),some(bank)=>cache.require_cpu_policy(bank)}
 let guarded:result<unit,alignment_threads.Failure>=match ready{err(e)=>result.err(alignment_threads.failure(e)),ok(_)=>match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(alignment_threads.failure(e)),ok(plan)=>match selected{
  none=>recording_io.run_guarded(struct.borrow(w,field=settings),w.first,w.second,w.output,w.cancel,w.progress,plan,journal,policy),
  some(recipe)=>ensemble_alignment_io.run_guarded(struct.borrow(w,field=settings),recipe,w.first,w.second,w.output,w.cancel,w.progress,plan,journal,policy)}}}
 let outcome:result<unit,string>=match guarded{ok(_)=>result.ok(()),err(error)=>{
  if error.poison_cpu{
   match w.retained{none=>{var bank:cache.Cache=cache.empty()
    cache.poison_cpu(bank)
    w.retained=option.some(bank)},some(bank)=>cache.poison_cpu(bank)}}
  result.err(alignment_threads.describe(error))}}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match outcome{ok(_)=>Completed{retained:retained,ok:true,directory:string.copy(w.output),message:"Detailed alignment and subtraction complete",queue_report:option.none()},
  err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
fn run_time_impl(work:TimeWork own,options:option<checked_input.Options> own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time,env} {
 var w:TimeWork=work
 var input_options:option<checked_input.Options>=options
 var journal:container.Journal=container.empty_journal()
 let outcome:result<audio_time.Report,string>=match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(e),ok(plan)=>audio_time.run_with_input_to(struct.borrow(w,field=settings),w.input,w.output,w.cancel,w.progress,plan,journal,input_options)}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match outcome{err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()},ok(report)=>{
  var message:string=text.concat("Audio processing complete: ",text.concat(string.from_int(report.frames),text.concat(" frames, ",text.concat(string.from_int(report.channels)," channels"))))
  if report.bypassed{string.append(message," (unchanged audio)")}
  if not report.temporary_removed{string.append(message,text.concat("; temporary audio remains at ",report.work_directory))}
  Completed{retained:retained,ok:true,directory:string.copy(w.output),message:message,queue_report:option.none()}}}
 attach_export(completed,journal,w.output)
}
pub fn run_time(work:TimeWork own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time,env} {
 run_time_impl(work,option.none())
}
pub fn run_time_checked(work:TimeWork own,options:checked_input.Options own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time,env} {
 run_time_impl(work,option.some(options))
}
fn run_alignment_impl(work:AlignmentWork own,options:option<checked_input.Options> own)->Completed effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 var w:AlignmentWork=work
 var input_options:option<checked_input.Options>=options
 var journal:container.Journal=container.empty_journal()
 let ready:result<unit,string>=match w.retained{none=>result.ok(()),some(bank)=>cache.require_cpu_policy(bank)}
 let outcome:result<unit,string>=match ready{err(e)=>result.err(e),ok(_)=>match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(e),ok(plan)=>alignment.run_with_input_to(struct.borrow(w,field=settings),w.first,w.second,w.output,w.cancel,w.progress,plan,journal,input_options)}}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match outcome{ok(_)=>Completed{retained:retained,ok:true,directory:string.copy(w.output),message:"Alignment and subtraction complete",queue_report:option.none()},
  err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
pub fn run_alignment(work:AlignmentWork own)->Completed effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 run_alignment_impl(work,option.none())
}
pub fn run_alignment_checked(work:AlignmentWork own,options:checked_input.Options own)->Completed effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
