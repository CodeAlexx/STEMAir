pub type ModelEnsembleWork=struct{retained:option<cache.Cache>,settings:model_ensemble_config.Recipe,input:string,output:string,cancel:string,progress:string,use_gpu:bool,gpu_index:u32=0,application_root:string="",mask_high_band:u32=0,mask_cleanup:bool=false,mask_cleanup_threshold:f64=0.2,mask_controls:string="",learned_controls:string="",recording_controls:string="",recording_state:string="",wav_choice:u32=4,codec_recipe:string="",export_max_frames:u64=0,export_max_stage_bytes:u64=0,export_max_encoded_bytes:u64=0}
fn execute_model_ensemble(w:ref<ModelEnsembleWork>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Ensemble>>)->result<unit,string> effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var configurations:array<string>=recording_policy.configurations<model_ensemble_config.Model>(struct.borrow(w.settings,field=models))
 var i:u64=0
 loop{if i==array.len(w.settings.models){break}
  let _=try recording_policy.include_processing(configurations,array.borrow(w.settings.models,i).processing)
  i+=1}
 var recording:recording_context.Context=try recording_policy.resolve_sources(w.recording_controls,recording_budget(input_options),w.recording_state,configurations)
 recording.device_index=w.gpu_index
 if w.use_gpu{let _=try device_selection.available(w.gpu_index)}
 let outcome:result<unit,string>=execute_model_ensemble_controlled(w,journal,input_options,naming_options,recording)
 w.recording_state=try recording_state.encode(recording)
 outcome
}

fn execute_model_ensemble_controlled(w:ref<ModelEnsembleWork>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Ensemble>>,recording:ref<recording_context.Context>)->result<unit,string> effects {alloc,fs.read,fs.write,fs.meta,gpu,process,time,env,ffi} {
 let _=try learned_request.decode(w.learned_controls)
 var request:mask_request.Policy=try inference_policy.resolve(w.mask_high_band,w.mask_cleanup,w.mask_cleanup_threshold,w.mask_controls)
 var plan:container.Plan=try export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes)
 let empty:bool=match w.retained{none=>true,some(_)=>false}
 if empty{w.retained=option.some(cache.empty())}
 let serialized:string=try model_ensemble_config.Recipe_encode(struct.borrow(w,field=settings)) map_err codec.describe
 var settings:model_ensemble_config.Recipe=try model_ensemble_config.Recipe_decode(serialized) map_err codec.describe
 let input:string=string.copy(w.input)
 let output:string=string.copy(w.output)
 let cancel:string=string.copy(w.cancel)
 let progress:string=string.copy(w.progress)
 let use_gpu:bool=w.use_gpu
 let root:string=string.copy(w.application_root)
 let learned_raw:string=string.copy(w.learned_controls)
 match w.retained{none=>result.err("Model ensemble cache is unavailable"),some(bank)=>{
  let _=try cache.select_learned(bank,learned_raw)
  if processing_app.enabled(settings){
   var inputs:recording_sources.Set=recording_sources.empty()
   var prepared:processing_app.Prepared=match naming_options{none=>{
    try processing_app.prepare_typed_with_sources_to(bank,settings,input,output,cancel,plan,input_options,use_gpu,root,inputs)},some(context)=>{
    var named:processing_app.NamedPrepared=try processing_app.prepare_typed_named_with_sources_to(bank,settings,input,output,cancel,plan,input_options,context,use_gpu,root,inputs)
    plan=struct.replace(named,container.wav_plan(plan.working_wav),field=format)
    struct.replace(named,processing_app.Prepared{members:[],options:model_ensemble_config.Options{outputs:[]},input:[],input_path:"",directory:""},field=prepared)}}
   let budget:typed_secondary_cpu.Limits=secondary_resources.limits()
   let _=try if use_gpu{cache.configure_learned_gpu_on_device(bank,learned_raw,recording.device_index)}else{cache.configure_learned_cpu(bank,learned_raw)}
   let limits:typed_processing.Limits=typed_processing.Limits{max_retained_bytes:budget.max_retained_bytes,max_working_bytes:budget.max_working_bytes,allow_provisional_spectral:budget.allow_provisional_spectral}
   var master:audio_result.Samples=audio_result.from_single(struct.replace(prepared,[],field=input))
   var result:typed_processing.Output=if use_gpu{try typed_processing_device.separate_with_policy_as_controlled_inputs(bank,struct.borrow(prepared,field=members),struct.borrow(prepared,field=options),master,cancel,progress,request,plan.working_wav,limits,recording,inputs)}else{try typed_processing_cpu.separate_with_policy_as_controlled_inputs(bank,struct.borrow(prepared,field=members),struct.borrow(prepared,field=options),master,cancel,progress,request,plan.working_wav,limits,recording,inputs)}
   return processing_app.export_typed_to(bank,prepared,result,use_gpu,cancel,progress,plan,journal)
  }
  var inputs:recording_sources.Set=recording_sources.empty()
  var prepared:model_ensemble_app.Prepared=match naming_options{none=>{
   try model_ensemble_app.prepare_typed_with_sources_to(bank,settings,input,output,cancel,progress,plan,input_options,use_gpu,root,inputs)},some(context)=>{
   var named:model_ensemble_app.NamedPrepared=try model_ensemble_app.prepare_typed_named_with_sources_to(bank,settings,input,output,cancel,progress,plan,input_options,context,use_gpu,root,inputs)
   plan=struct.replace(named,container.wav_plan(plan.working_wav),field=format)
   struct.replace(named,model_ensemble_app.Prepared{members:[],options:model_ensemble_config.Options{outputs:[]},input:[],input_path:"",directory:""},field=prepared)}}
  let _=try if use_gpu{cache.configure_learned_gpu_on_device(bank,learned_raw,recording.device_index)}else{cache.configure_learned_cpu(bank,learned_raw)}
  if use_gpu{
   let budget:typed_secondary_cpu.Limits=secondary_resources.limits()
   let limits:typed_source.Limits=typed_source.Limits{max_working_bytes:budget.max_working_bytes,allow_provisional_spectral:budget.allow_provisional_spectral}
   var result:typed_model_ensemble.Output=try typed_model_ensemble_device.separate_with_policy_as_controlled_inputs(bank,array.view(prepared.members),struct.borrow(prepared,field=options),array.view(prepared.input),cancel,progress,request,plan.working_wav,limits,recording,inputs)
   model_ensemble_app.export_typed_to(bank,settings,prepared,result,true,cancel,progress,plan,journal)
  }else{
   let budget:typed_secondary_cpu.Limits=secondary_resources.limits()
   let limits:typed_source.Limits=typed_source.Limits{max_working_bytes:budget.max_working_bytes}
   var result:typed_model_ensemble.Output=try typed_model_ensemble.separate_cpu_with_policy_as_controlled_inputs(bank,array.view(prepared.members),struct.borrow(prepared,field=options),array.view(prepared.input),cancel,progress,request,plan.working_wav,limits,recording,inputs)
   model_ensemble_app.export_typed_to(bank,settings,prepared,result,false,cancel,progress,plan,journal)
  }
 }}
}
pub fn run_model_ensemble(work:ModelEnsembleWork own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_model_ensemble_impl(work,option.none(),option.none())
}
pub fn run_model_ensemble_named(work:ModelEnsembleWork own,context:naming.Ensemble own,options:option<checked_input.Options> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_model_ensemble_impl(work,options,option.some(context))
}
fn run_model_ensemble_impl(work:ModelEnsembleWork own,options:option<checked_input.Options> own,context:option<naming.Ensemble> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var w:ModelEnsembleWork=work
 var journal:container.Journal=container.empty_journal()
 var input_options:option<checked_input.Options>=options
 var naming_options:option<naming.Ensemble>=context
 let result:result<unit,string>=execute_model_ensemble(w,journal,input_options,naming_options)
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:true,directory:string.copy(w.output),message:"Model ensemble complete",queue_report:option.none()},err(e)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
fn run_ensemble_impl(work:EnsembleWork own,options:option<checked_input.Options> own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time} {
 var w:EnsembleWork=work
 var input_options:option<checked_input.Options>=options
 var journal:container.Journal=container.empty_journal()
 let result:result<unit,string>=match export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes){err(e)=>result.err(e),ok(plan)=>ensemble_app.run_with_input_to(struct.borrow(w,field=settings),w.output,w.cancel,w.progress,plan,journal,input_options)}
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{retained:retained,ok:true,directory:string.copy(w.output),message:"Ensemble complete",queue_report:option.none()},err(e)=>Completed{retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}
pub fn run_ensemble(work:EnsembleWork own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time} {
 run_ensemble_impl(work,option.none())
}
pub fn run_ensemble_checked(work:EnsembleWork own,options:checked_input.Options own)->Completed effects {alloc,fs.read,fs.write,fs.meta,process,time} {
 run_ensemble_impl(work,option.some(options))
}
fn status(path:str,message:str)->unit effects {alloc,fs.write} {
 let _=files.write_atomic(path,text.concat(path,".tmp"),message)
 ()
}
fn execute(w:ref<Work>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Context>>)->result<unit,string> effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 let configurations:array<string>=[string.copy(w.settings)]
 var recording:recording_context.Context=try recording_policy.resolve_sources(w.recording_controls,recording_budget(input_options),w.recording_state,configurations)
 recording.device_index=w.gpu_index
 if w.use_gpu{let _=try device_selection.available(w.gpu_index)}
 let outcome:result<unit,string>=execute_controlled(w,journal,input_options,naming_options,recording)
 w.recording_state=try recording_state.encode(recording)
 outcome
}

fn execute_controlled(w:ref<Work>,journal:ref<container.Journal>,input_options:ref<option<checked_input.Options>>,naming_options:ref<option<naming.Context>>,recording:ref<recording_context.Context>)->result<unit,string> effects {alloc,fs.read,fs.write,fs.meta,gpu,process,time,env,ffi} {
 let learned:learned_request.Settings=try learned_request.decode(w.learned_controls)
 var request:mask_request.Policy=try inference_policy.resolve(w.mask_high_band,w.mask_cleanup,w.mask_cleanup_threshold,w.mask_controls)
 var plan:container.Plan=try export_plan_limited(w.wav_choice,w.codec_recipe,w.export_max_frames,w.export_max_stage_bytes,w.export_max_encoded_bytes)
 if control.cancelled(str.view(w.cancel)){return result.err("Separation cancelled")}
 var settings:engine.Profile=try engine.read_typed(str.view(w.settings))
 match naming_options{none=>{},some(context)=>{
  var selected:naming.Selected=try naming.select(w.input,w.output,context,struct.borrow(settings,field=targets),plan)
  let _=try container.require_directory(w.output)
  if context.model_folder{match files.mkdirs(selected.directory){ok(_)=>{},err(_)=>{return result.err("Cannot create the selected model output folder")}}}
  w.output=struct.replace(selected,"",field=directory)
  plan=struct.replace(selected,container.wav_plan(plan.working_wav),field=plan)}}
 var learned_plan:container.Plan=try learned_output.planned(plan,struct.borrow(settings,field=targets),learned,false,false)
 let _=try app.preflight_to(str.view(w.output),array.len(learned_plan.source_names),learned_plan,journal)
 var inputs:recording_sources.Set=recording_sources.empty()
 var accepted:array<engine.Profile>=[try engine.decode_typed(settings.identity)]
 var source:audio.AudioBuffer=try match input_options{
  none=>app.read_recording(str.view(w.input),settings.sample_rate,str.view(w.output)),
  some(options)=>model_input.prepare_into(w.input,settings.sample_rate,accepted,options,inputs),
 } map_err app.recording_error
 let _=try container.preflight_extent(array.len(source.samples),source.rate,source.channels,plan)
 let input:array<f32>=try app.planar(source,settings.sample_rate) map_err app.recording_error
 let lower:array<f32>=try recording_sources.lower(inputs,settings.identity,typed_source.Limits{max_working_bytes:secondary_resources.limits().max_working_bytes})
 let empty:bool=match w.retained{none=>true,some(_)=>false}
 if empty{w.retained=option.some(cache.empty())}
 let cancel:string=string.copy(str.view(w.cancel))
 let progress:string=string.copy(str.view(w.progress))
 let destination:string=string.copy(str.view(w.output))
 let checkpoint:string=string.copy(w.checkpoint)
 let use_gpu:bool=w.use_gpu
 let root:string=string.copy(w.application_root)
 let learned_raw:string=string.copy(w.learned_controls)
 match w.retained{
  none=>result.err("Model session unavailable"),
  some(retained)=>{
   status(str.view(progress),"Preparing separation model")
   let copy:engine.Profile=try engine.decode_typed(settings.identity)
   var backend:option<cache.CpuBackend>=if use_gpu or not cpu_runtime.needs_selection(retained,settings){option.none()}else{try cpu_runtime.selected(root,settings)}
   let index:u64=if use_gpu{try cache.acquire_typed(retained,checkpoint,copy)}else{try cache.acquire_cpu_typed(retained,checkpoint,copy,backend)}
   let _=try if use_gpu{cache.configure_learned_gpu_on_device(retained,learned_raw,recording.device_index)}else{cache.configure_learned_cpu(retained,learned_raw)}
   let model:ref<engine.Loaded>=struct.borrow(array.borrow(retained.entries,index),field=model)
   if str.view(settings.identity)!=str.view(model.profile.identity){return result.err("Model configuration changed; reload the model before processing")}
   status(str.view(progress),"Separating audio")
   var output:audio_result.Samples=if use_gpu{
    try gpu_inference.separate_with_policy_and_band_input(retained,index,array.view(input),str.view(cancel),str.view(progress),request,recording,array.view(lower))
   }else{try cpu_inference.separate_with_policy_and_band_input(retained,index,array.view(input),str.view(cancel),str.view(progress),request,recording,array.view(lower))}
   if control.cancelled(str.view(cancel)){return result.err("Separation cancelled")}
   let samples:u64=audio_result.count(output)/(2*array.len(settings.targets))
   status(str.view(progress),if container.extension(plan)=="wav"{"Writing source WAVs"}else{"Writing source audio"})
   let backend:str=if use_gpu{if output.precision==audio_result.Precision.Float64{"native-air-gpu-f64"}else{"native-air-gpu-f32"}}else{if output.precision==audio_result.Precision.Float64{"native-air-cpu-f64"}else{"native-air-cpu-f32"}}
   if learned.noise or learned.room{
    let master:audio_result.Samples=audio_result.from_single(numeric.copy(array.view(input)))
    let limits:typed_source.Limits=typed_source.Limits{max_working_bytes:8589934592}
    var waves:array<typed_source.Wave>=if use_gpu{try learned_single.finish_gpu(retained,settings.kind,struct.borrow(settings,field=targets),master,output,cancel,limits,array.view(recording.frequency_reference))}else{try learned_single.finish_cpu(retained,settings.kind,struct.borrow(settings,field=targets),master,output,cancel,limits,array.view(recording.frequency_reference))}
    return app.export_waves_to(destination,settings.sample_rate,waves,backend,cache.loads(retained)+cache.learned_loads(retained),cancel,progress,learned_plan,journal)}
   app.export_typed_to(str.view(destination),settings.sample_rate,struct.borrow(settings,field=targets),output,samples,backend,cache.loads(retained),cancel,progress,plan,journal)
  },}
}
pub fn run(work:Work own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_single(work,option.none(),option.none())
}

// Opt-in checked input; the same execution/export path returns the retained bank.
pub fn run_checked(work:Work own,options:checked_input.Options own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_single(work,option.some(options),option.none())
}
pub fn run_named(work:Work own,context:naming.Context own,options:option<checked_input.Options> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_single(work,options,option.some(context))
}
fn run_single(work:Work own,options:option<checked_input.Options> own,context:option<naming.Context> own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 var w:Work=work
 var journal:container.Journal=container.empty_journal()
 var input_options:option<checked_input.Options>=options
 var naming_options:option<naming.Context>=context
 let result:result<unit,string>=execute(w,journal,input_options,naming_options)
 let retained:option<cache.Cache>=struct.replace(w,option.none(),field=retained)
 let completed:Completed=match result{ok(_)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:true,directory:string.copy(w.output),message:"Separation complete",queue_report:option.none()},
  err(e)=>Completed{recording_state:string.copy(w.recording_state),retained:retained,ok:false,message:e,queue_report:option.none()}}
 attach_export(completed,journal,w.output)
}

// Runtime selection belongs to the caller; this verifies the explicit recipe again.
pub fn export_plan(choice:u32,recipe:str)->result<container.Plan,string> effects {alloc,fs.read,fs.meta} {
 export_plan_limited(choice,recipe,0,0,0)
}
pub fn export_plan_limited(choice:u32,recipe:str,max_frames:u64,max_stage_bytes:u64,max_encoded_bytes:u64)->result<container.Plan,string> effects {alloc,fs.read,fs.meta} {
 let kind:audio.WavSubtype=try wav.from_choice(choice)
 if view.len(str.bytes(recipe))>16384{return result.err("Codec recipe exceeds 16 KiB")}
 var plan:container.Plan=if str.len(recipe)==0{container.wav_plan(kind)}else{
  let settings:compressed.Settings=try compressed.Settings_decode(recipe) map_err codec.describe
  try container.compressed_plan(kind,settings)}
 if max_frames>0 or max_stage_bytes>0 or max_encoded_bytes>0{
  plan=try container.with_limits(plan,compressed.Limits{max_frames:max_frames,max_stage_bytes:max_stage_bytes,max_encoded_bytes:max_encoded_bytes})}
 let _=try container.verify(plan)
 result.ok(plan)
}
fn attach_export(completed:Completed own,journal:ref<container.Journal>,directory:str)->Completed effects {alloc} {
 var value:Completed=completed
 if not value.ok and str.len(journal.failure)==0{container.record_failure(journal,"",value.message)}
 let count:u64=array.len(journal.artifacts)
 match container.encode_journal(journal){ok(report)=>{value.export_report=report},err(problem)=>{
  value.ok=false
  string.append(value.message,text.concat("; cannot serialize export reports: ",problem))}}
 if count>0 and not value.ok{
  string.append(value.message,text.concat("; ",text.concat(string.from_int(count)," audio files published")))
  if str.len(value.directory)==0{value.directory=string.copy(directory)}}
 var retained:u64=0
 var first:string=""
 var at:u64=0
 loop{if at==count{break}
  let artifact:ref<container.Artifact>=array.borrow(journal.artifacts,at)
  let path:string=match artifact.compressed{none=>match artifact.wav{none=>"",some(report)=>if report.staging_removed{""}else{string.copy(report.staging_path)}},some(report)=>if report.work_retained{string.copy(report.work_path)}else{if report.staging_removed{""}else{string.copy(report.staging_path)}}}
  if str.len(path)>0{retained+=1
   if str.len(first)==0{first=string.copy(path)}}
  at+=1}
 if retained>0{string.append(value.message,text.concat("; ",text.concat(string.from_int(retained),text.concat(" export work retained; first: ",first))))}
 value
}

pub fn run_secondary_checked(work:SecondaryWork own,options:checked_input.Options own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_secondary_impl(work,option.some(options),option.none())
}

pub fn run_model_ensemble_checked(work:ModelEnsembleWork own,options:checked_input.Options own)->Completed effects {alloc, env, ffi, fs.meta, fs.read, fs.write, gpu, process, random, time} {
 run_model_ensemble_impl(work,option.some(options),option.none())
}
