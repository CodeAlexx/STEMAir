      let _=files.remove(cancel)
      let _=files.remove(progress)
      previous_progress=string.new()
      array.push(jobs,task.spawn(audio_jobs.Queue{work:option.some(queued),policy:ref.swap(input_policy,option.none()),sample:ref.swap(sample_policy,option.none())},fn=audio_jobs.run_Queue))
