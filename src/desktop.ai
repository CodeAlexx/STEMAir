    if id=="session_save" or id=="preferences_save"{match inference_policy.current(state.mask_tta,mask_window_draft,mask_aggression_draft){ok(_)=>{},err(problem)=>{
     let _=desk.set_text(app,"status",problem)
     continue}}}
    if id=="session_save" or id=="preferences_save"{match recording_policy.current_with_pitch(state.recording_override,recording_shifts_draft,state.recording_split,recording_overlap_draft,recording_segment_draft,recording_seed_draft,state.inference_pitch,inference_semitones_draft,state.match_frequency){ok(_)=>{},err(problem)=>{
     let _=desk.set_text(app,"status",problem)
     continue}}}
    if id=="session_save"{let _=desk.dialog(app,"session_save","save","Save session preset","session.stemair.json",root)
