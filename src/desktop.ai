      first:string.copy(state.alignment_first),second:string.copy(state.alignment_second),output:string.copy(state.output),cancel:string.copy(cancel),progress:string.copy(progress)}
     array.push(jobs,task.spawn(audio_jobs.Alignment{work:option.some(work),policy:ref.swap(input_policy,option.none())},fn=audio_jobs.run_Alignment))
     busy(app,true)
     let _=desk.set_text(app,"status","Aligning and subtracting audio…")
     continue}
    if id=="catalog_page"{show_page(app,state,7.0)}
    if id=="catalog_focus_directory"{show_page(app,state,7.0)
