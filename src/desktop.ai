 let _=desk.set_bool(app,"model_keep","active",state.model_keep)
 let _=desk.set_bool(app,"model_residual","active",state.model_residual)
 let _=desk.set_bool(app,"model_spectral","active",state.model_spectral)
 let _=desk.set_bool(app,"secondary_normalize","active",state.secondary_normalize)
 let _=desk.set_bool(app,"secondary_keep","active",state.secondary_keep)
 let _=desk.set_bool(app,"secondary_residual","active",state.secondary_residual)
 let _=desk.set_bool(app,"secondary_spectral","active",state.secondary_spectral)
 let _=desk.set_bool(app,"preprocess_residual","active",state.preprocess_residual)
 let _=desk.set_bool(app,"preprocess_spectral","active",state.preprocess_spectral)
 let _=desk.set_bool(app,"preprocess_extra","active",state.preprocess_extra)
 let _=desk.set_bool(app,"queue_continue","active",state.queue_continue)
 let _=desk.set_number(app,"export_subtype","selected",state.export_subtype)
 let _=desk.set_number(app,"output_container","selected",state.output_container)
 let _=desk.set_number(app,"mp3_bitrate","selected",state.mp3_bitrate)
 let _=desk.set_number(app,"audio_budget","selected",state.audio_budget)
 let _=desk.set_number(app,"single_outputs","selected",state.single_outputs)
 let _=desk.set_number(app,"single_complement","selected",state.single_complement)
 let _=desk.set_number(app,"model_primary","selected",state.model_primary)
 let _=desk.set_number(app,"model_secondary","selected",state.model_secondary)
 let _=desk.set_number(app,"secondary_target","selected",state.secondary_target)
 let _=desk.set_number(app,"secondary_outputs","selected",state.secondary_outputs)
 let _=desk.set_number(app,"model_outputs","selected",if state.model_paired{1.0}else{0.0})
 let _=desk.set_number(app,"vocal_outputs","selected",state.secondary_outputs)
 let _=desk.set_bool(app,"vocal_normalize","active",state.secondary_normalize)
 let _=desk.set_bool(app,"vocal_keep","active",state.secondary_keep)
 let _=desk.set_bool(app,"vocal_mixes","active",state.vocal_options.mixes)
 let _=desk.set_bool(app,"vocal_mix_only","active",state.vocal_options.mix_only)
 let _=desk.set_bool(app,"vocal_save_only","active",state.vocal_options.vocal_only)
 ensemble_list(app,state.ensemble_inputs,lists)
 model_list(app,state.ensemble_models)
 secondary_list(app,state.secondary_rules)
 preprocess_list(app,state.preprocess_model)
 vocal_list(app,state.vocal_model)
 queue_list(app,state.queue_items,lists)
 export_controls(app,state)
 ()
}
pub fn main(args:view<str>)->i32 effects {alloc,env,fs.read,fs.write,fs.meta,io.write,net,random,time,thread,process,gpu,ffi} {
 if view.len(args)!=3 and view.len(args)!=5 and view.len(args)!=7{io.ewrite("usage: StemAIR AIR_UI PROJECT_ROOT [RECORDING OUTPUT_DIRECTORY [CONFIG MODEL]]\n")
  return 2}
 let root:str=view.get(args,2)
 var app:desk.Session=match desk.prepare(view.get(args,1),path.join(root,"src/desktop.ui"),path.join(root,"src/desktop.css")){ok(v)=>v,err(e)=>{io.ewrite(e)
  return 1},}
 var state:preferences.State=preferences.defaults(root)
 var preference_file:string=""
 var preference_warning:string=""
 var preference_writable:bool=true
 match preferences.location(){err(e)=>{preference_warning=e
  preference_writable=false},ok(file)=>{preference_file=file
  match preferences.load(preference_file,root){ok(loaded)=>{state=loaded},err(e)=>{preference_warning=e
   preference_writable=false}}}}
 var preference_serialized:string=match preferences.encode(state){ok(v)=>v,err(_)=>string.new()}
 var preference_dirty:bool=view.len(args)>=5
 if view.len(args)==7{state.model_definition=""
  state.settings=string.copy(view.get(args,5))
  state.checkpoint=string.copy(view.get(args,6))}
 if view.len(args)>=5{state.input=string.copy(view.get(args,3))
  state.output=string.copy(view.get(args,4))}
 let preference_temporary:string=text.concat(preference_file,text.concat(".",text.concat(path.basename(app.root),".tmp")))
 var audition:listen.State=listen.empty()
 audition.selection=string.copy(state.input)
 audition.root=string.copy(state.output)
 var retained:option<cache.Cache>=option.none()
 var lists:input_lists.State=input_lists.empty()
 var paired:paired_panel.State=paired_panel.empty()
 var input_activation_file:bool=false
 var catalog_state:model_panel.State=model_panel.empty(root)
 if path.is_absolute(state.checkpoint){catalog_state.directory=path.dirname(state.checkpoint)}
 var editor:model_editor.State=model_editor.empty()
 var catalog_active:bool=false
 var queue_active:bool=false
 var audio_request:u64=0
 var preset_file:string=""
 var preset_identity:string=""
 let cancel:string=path.join(str.view(app.root),"cancel")
 let progress:string=path.join(str.view(app.root),"progress")
 var previous_progress:string=string.new()
 var cleanup_draft:string=string.copy(state.cleanup_threshold)
 var mask_window_draft:string=string.copy(state.mask_window)
 var mask_aggression_draft:string=string.copy(state.mask_aggression)
 var inference_semitones_draft:string=string.copy(state.inference_semitones)
 var recording_shifts_draft:string=string.copy(state.recording_shifts)
 var recording_overlap_draft:string=string.copy(state.recording_overlap)
 var recording_segment_draft:string=string.copy(state.recording_segment)
 var gpu_index_draft:string=string.copy(state.gpu_index)
 var recording_seed_draft:string=string.copy(state.recording_seed)
 var answer:i32=0
 task.scope{
  var helpers:array<task<proc.Exit>>=[]
  var jobs:array<task<job.Completed>>=[]
  array.push(helpers,task.spawn(desk.plan(app),fn=proc.start))
  match desk.connect(app){err(e)=>{io.ewrite(e)
   answer=1},ok(_)=>{
   preferences_display(app,state,lists,paired)
       cleanup_draft=string.copy(state.cleanup_threshold)
       mask_window_draft=string.copy(state.mask_window)
       mask_aggression_draft=string.copy(state.mask_aggression)
       inference_semitones_draft=string.copy(state.inference_semitones)
       recording_shifts_draft=string.copy(state.recording_shifts)
       recording_overlap_draft=string.copy(state.recording_overlap)
       recording_segment_draft=string.copy(state.recording_segment)
       recording_seed_draft=string.copy(state.recording_seed)
       gpu_index_draft=string.copy(state.gpu_index)
   let _=desk.shortcut(app,"<Control><Shift>F7","session_save")
   let _=desk.shortcut(app,"<Control><Shift>F8","session_open")
   let _=desk.shortcut(app,"<Control><Shift>F9","session_rename")
   let _=desk.shortcut(app,"<Control><Shift>F10","session_delete")
   let _=desk.shortcut(app,"<Control><Shift>r","model_preset_rename")
   let _=desk.shortcut(app,"<Control><Shift>d","model_preset_delete")
   match model_panel.refresh(app,catalog_state){ok(_)=>{},err(e)=>{let _=desk.set_text(app,"catalog_status",e)}}
   let _=desk.shortcut(app,"<Control><Shift>F1","catalog_page")
   let _=desk.shortcut(app,"<Control><Shift>F2","catalog_focus_directory")
   let _=desk.shortcut(app,"<Control><Shift>F3","catalog_focus_profiles")
   let _=desk.shortcut(app,"<Control><Shift>F4","catalog_verify")
   let _=desk.shortcut(app,"<Control><Shift>F5","catalog_use")
   let _=desk.shortcut(app,"<Control><Shift>F6","catalog_acquire")
   let _=desk.shortcut(app,"<Control>r","catalog_refresh")
   let _=desk.set_text(app,"audio_file",audition.selection)
   let _=desk.set_text(app,"audio_folder",audition.root)
   let _=desk.shortcut(app,"<Control>F7","listen_page")
   let _=desk.shortcut(app,"<Control><Shift>i","audio_focus")
   let _=desk.shortcut(app,"<Control><Shift>u","audio_choose")
   let _=desk.shortcut(app,"<Control>F8","audio_input")
   let _=desk.shortcut(app,"F8","audio_toggle")
   let _=desk.shortcut(app,"F9","audio_stop")
   let _=desk.shortcut(app,"<Control>F9","audio_refresh")
   let _=desk.shortcut(app,"<Control>F10","audio_choose_folder")
   let _=desk.shortcut(app,"<Control>F11","audio_focus_mute")
   let _=desk.shortcut(app,"<Control><Shift>F11","audio_focus_results")
   let _=desk.shortcut(app,"<Control>F12","audio_focus_seek")
   let _=desk.shortcut(app,"<Control><Shift>F12","audio_focus_volume")
   if str.len(preference_warning)>0{
    let message:string=text.concat("Preferences were not restored: ",text.concat(preference_warning,". Save preferences to replace the saved file, or restore defaults."))
    let _=desk.set_text(app,"status",message)
    io.ewrite(text.concat(message,"\n"))}
   let _=desk.shortcut(app,"<Control><Alt><Shift>s","preferences_save")
   let _=desk.shortcut(app,"<Control><Alt><Shift>r","preferences_reset")
   let _=desk.shortcut(app,"<Control>Return","separate")
   let _=desk.shortcut(app,"<Control>q","quit")
   let _=desk.shortcut(app,"Escape","cancel")
   let _=desk.shortcut(app,"<Control>e","ensemble_add")
   let _=desk.shortcut(app,"<Control><Alt>n","focus_audio_inputs")
   let _=desk.shortcut(app,"<Control><Alt>q","focus_queue_inputs")
   let _=desk.shortcut(app,"<Control><Shift>e","ensemble_current")
   let _=desk.shortcut(app,"<Control>1","ensemble_min")
   let _=desk.shortcut(app,"<Control>2","ensemble_max")
   let _=desk.shortcut(app,"<Control>3","ensemble_average")
   let _=desk.shortcut(app,"<Control>4","tool_combine")
   let _=desk.shortcut(app,"<Control>5","tool_mix")
   let _=desk.shortcut(app,"<Control>6","tool_reduce")
   let _=desk.shortcut(app,"<Control><Alt>4","tool_spectral")
   let _=desk.shortcut(app,"<Control>7","focus_tool_amount")
   let _=desk.shortcut(app,"<Control><Alt>5","tool_pitch")
   let _=desk.shortcut(app,"<Control><Alt>7","focus_pitch_amount")
   let _=desk.shortcut(app,"<Control><Alt>6","alignment_run")
   let _=desk.shortcut(app,"<Control><Alt>a","recording_alignment_run")
   let _=desk.shortcut(app,"<Control><Alt>f","focus_alignment_first")
   let _=desk.shortcut(app,"<Control><Alt>g","focus_alignment_second")
   let _=desk.shortcut(app,"<Control><Alt>h","focus_alignment_polarity")
   let _=desk.shortcut(app,"<Control><Alt>j","focus_alignment_save")
   let _=desk.shortcut(app,"<Control><Alt>t","tool_tempo")
   let _=desk.shortcut(app,"<Control><Alt>i","tool_pitch_preserve")
   let _=desk.shortcut(app,"<Control><Alt>u","focus_tempo_amount")
   let _=desk.shortcut(app,"<Control><Alt>y","focus_pitch_preserve_amount")
   let _=desk.shortcut(app,"<Control>m","model_add")
   let _=desk.shortcut(app,"<Control><Alt>e","model_processing_add")
   let _=desk.shortcut(app,"<Control><Alt><Shift>e","model_processing_clear")
   let _=desk.shortcut(app,"<Control><Shift>s","model_preset_save")
   let _=desk.shortcut(app,"<Control><Alt>o","model_preset_open")
   let _=desk.shortcut(app,"<Control><Shift>Return","model_run")
   let _=desk.shortcut(app,"<Control>k","focus_settings")
   let _=desk.shortcut(app,"<Control><Shift>k","focus_checkpoint")
   let _=desk.shortcut(app,"<Control><Shift>o","focus_output")
   let _=desk.shortcut(app,"<Control>F1","single_page")
   let _=desk.shortcut(app,"<Control>F2","models_page")
   let _=desk.shortcut(app,"<Control>F3","audio_page")
   let _=desk.shortcut(app,"<Control>F4","queue_page")
   let _=desk.shortcut(app,"<Control>F5","secondary_page")
   let _=desk.shortcut(app,"<Control>8","secondary_assign")
   let _=desk.shortcut(app,"<Control>9","focus_secondary_weight")
   let _=desk.shortcut(app,"<Control><Alt>Return","secondary_run")
   let _=desk.shortcut(app,"<Control>0","focus_secondary_outputs")
   let _=desk.shortcut(app,"<Control><Alt>p","preprocess_assign")
   let _=desk.shortcut(app,"<Control><Shift>p","preprocess_clear")
   let _=desk.shortcut(app,"<Control>F6","vocal_page")
   let _=desk.shortcut(app,"<Control><Alt>w","focus_export_subtype")
   let _=desk.shortcut(app,"<Control><Alt>c","focus_output_container")
   let _=desk.shortcut(app,"<Control><Alt>r","focus_mp3_bitrate")
   let _=desk.shortcut(app,"<Control><Alt>d","focus_codec_directory")
   let _=desk.shortcut(app,"<Control><Alt>0","focus_single_outputs")
   let _=desk.shortcut(app,"<Control><Alt>8","focus_single_complement")
   let _=desk.shortcut(app,"<Control><Shift>m","focus_model_outputs")
   let _=desk.shortcut(app,"<Control><Alt>l","vocal_assign")
   let _=desk.shortcut(app,"<Control><Shift>l","vocal_clear")
   let _=desk.shortcut(app,"<Control><Alt>9","focus_vocal_amount")
   let _=desk.shortcut(app,"<Control>b","queue_add")
   let _=desk.shortcut(app,"<Control><Shift>b","queue_single")
   let _=desk.shortcut(app,"<Control><Alt>b","queue_ensemble")
   let _=desk.shortcut(app,"<Control><Shift>a","queue_current")
   let _=desk.shortcut(app,"<Control><Alt>s","queue_secondary")
   loop{
    match tasks.join_next<job.Completed>(jobs,0){none=>{},some(completed)=>{
     var finished:job.Completed=completed
     retained=struct.replace(finished,option.none(),field=retained)
     if str.len(finished.mastering_report)>0{io.write(text.concat("Reference mastering report: ",text.concat(finished.mastering_report,"\n")))}
     if str.len(finished.paired_snapshot)>0{
      state.paired_snapshot=string.copy(finished.paired_snapshot)
      preference_dirty=true
      paired_panel.refresh(app,state,paired)}
     if str.len(finished.paired_report)>0{
      io.write(text.concat("Paired recording report: ",text.concat(finished.paired_report,"\n")))
      let _=desk.set_text(app,"pairs_report",text.concat(match paired_state.decode(state.paired_snapshot){ok(saved)=>match paired_panel.details(saved){ok(value)=>value,err(error)=>error},err(error)=>error},text.concat("\n",finished.message)))}
     if str.len(finished.sample_report)>0{
      match sample.Envelope_decode(finished.sample_report){err(e)=>{finished.message=codec.describe(e)},ok(report)=>{
       var sampled:sample.Envelope=report
       let details:string=sample_panel.details(sampled)
       let _=desk.set_text(app,if sampled.queue{"queue_verification_details"}else{"ensemble_verification_details"},details)
       io.write(text.concat(details,"\n"))}}}
     if str.len(finished.verification_report)>0{
      match verification_data.Envelope_decode(finished.verification_report){err(e)=>{finished.message=codec.describe(e)},ok(report)=>{
       var verified:verification_data.Envelope=report
       let details:string=verification.details(verified)
       let _=desk.set_text(app,if verified.queue{"queue_verification_details"}else{"ensemble_verification_details"},details)
       io.write(text.concat(details,"\n"))
       if verified.report.completed{
        let applied:result<unit,string>=if verified.queue{
         verification.apply_queue(verified,struct.borrow(state,field=queue_items),lists.queue.generation)}else{
         verification.apply_audio(verified,struct.borrow(state,field=ensemble_inputs),lists.audio.generation)}
        match applied{err(e)=>{finished.message=e},ok(_)=>{
         preference_dirty=true
         if verified.queue{queue_list(app,state.queue_items,lists)}else{ensemble_list(app,state.ensemble_inputs,lists)}}}
       }}}}
     if catalog_active{
      catalog_active=false
      if finished.ok and str.len(finished.catalog_settings)>0{
       var selected_settings:string=string.copy(finished.catalog_settings)
       var selected_definition:string=""
       let default_selection:result<unit,string>=match model_catalog.find(catalog_state.entries,finished.catalog_profile){none=>result.err("Verified model is no longer in the admitted catalog"),some(index)=>{
        match model_draft.selected(state.model_defaults,array.borrow(catalog_state.entries,index),root){err(e)=>result.err(e),ok(binding)=>{
         match binding{none=>{},some(value)=>{selected_settings=string.copy(value.configuration)
          selected_definition=string.copy(value.definition)}}
         result.ok(())}}}}
       match default_selection{err(e)=>{finished.message=text.concat("Model verified but saved defaults were not applied: ",e)},ok(_)=>{
        state.settings=selected_settings
        state.model_definition=selected_definition
        state.checkpoint=string.copy(finished.catalog_checkpoint)
        preference_dirty=true
        let _=desk.set_text(app,"settings",state.settings)
        let _=desk.set_text(app,"checkpoint",state.checkpoint)
        model_editor.close(app,editor)}}}
      match model_panel.refresh(app,catalog_state){ok(_)=>{},err(e)=>{io.ewrite(text.concat(e,"\n"))}}
      let _=desk.set_text(app,"catalog_status",finished.message)
      if str.len(finished.catalog_report)>0{io.write(text.concat("Model acquisition report: ",text.concat(finished.catalog_report,"\n")))}}
     if str.len(finished.directory)>0{
      match listen.refresh(app,audition,finished.directory){ok(_)=>{},err(e)=>{let _=desk.set_text(app,"audio_results_status",e)}}}

     match finished.queue_report{none=>{},some(report)=>{state.queue_items=queue_pending(state.queue_items,report)
      state.queue_recording_state=string.copy(finished.recording_state)
      if array.len(state.queue_items)==0{state.queue_model_snapshot=""
     state.queue_cleanup_snapshot=""
     state.queue_learned_snapshot=""
     state.queue_inference_snapshot=""
     state.queue_recording_snapshot=""
     state.queue_recording_state=""
       state.queue_naming_snapshot=""}
      preference_dirty=true
      queue_list(app,state.queue_items,lists)}}
     queue_active=false
     let _=desk.set_text(app,"status",str.view(finished.message))
     busy(app,false)
     let _=desk.set_bool(app,"cleanup_threshold","sensitive",state.cleanup_enabled)
     export_controls(app,state)
     io.write(text.concat(str.view(finished.message),"\n"))
    },}
    if array.len(jobs)>0{
     match files.read_text(str.view(progress)){err(_)=>{},ok(value)=>{
      var text:string=value
      if queue_active{match files.read_text(text.concat(progress,".queue")){err(_)=>{},ok(overall)=>{text=text.concat(overall,text.concat("\n",text))}}}
      if text!=previous_progress{previous_progress=text
       let _=desk.set_text(app,"status",str.view(previous_progress))
       if catalog_active{let _=desk.set_text(app,"catalog_status",previous_progress)}}
     },}}
    if preference_writable and preference_dirty{
     match preferences.persist(state,preference_file,preference_temporary,preference_serialized){ok(raw)=>{preference_serialized=raw
      preference_dirty=false},err(e)=>{
      preference_writable=false
      let _=desk.set_text(app,"status",e)
      io.ewrite(text.concat(e,"\n"))}}}
    var event:json.Document=match desk.next(app,100){ok(value)=>match value{some(v)=>v,none=>{continue},},err(e)=>{io.ewrite(e)
     answer=1
     break},}
    let kind:string=desk.field(event,"event")
    let id:string=desk.field(event,"id")
    if kind=="window" and id=="window"{
     let width:f64=desk.number(event,"width")
     let height:f64=desk.number(event,"height")
     if fp.is_finite(width) and fp.is_finite(height) and width>=320.0 and height>=240.0 and
        width<=32768.0 and height<=32768.0 and fp.floor(width)==width and fp.floor(height)==height{
      let maximized:bool=desk.boolean(event,"maximized")
      if not maximized or state.window_width==0{state.window_width=cast.sat(width)
       state.window_height=cast.sat(height)}
      state.window_maximized=maximized
      preference_dirty=true}
     continue}
    if kind=="change" and id=="workflow"{
     let page:f64=desk.number(event,"value")
     if fp.is_finite(page) and page>=0.0 and page<=7.0 and fp.floor(page)==page{
      state.workflow_page=page
      preference_dirty=true}
     continue}
    if kind=="dialog" and (id=="session_rename" or id=="session_delete" or id=="model_preset_rename" or id=="model_preset_delete"){
     preset_file=""
     preset_identity=""
     if array.len(jobs)>0 or desk.boolean(event,"cancelled"){continue}
     let file:string=desk.field(event,"value")
     if str.len(file)==0{continue}
     let ensemble:bool=id=="model_preset_rename" or id=="model_preset_delete"
     let identity:result<string,string>=if ensemble{presets.identity(file)}else{session_presets.identity(file)}
     match identity{err(e)=>{let _=desk.set_text(app,"status",e)},ok(digest)=>{
      preset_file=file
      preset_identity=digest
      if id=="session_rename" or id=="model_preset_rename"{
       let _=desk.prompt(app,if ensemble{"model_preset_rename_name"}else{"session_rename_name"},if ensemble{"Rename ensemble preset"}else{"Rename session preset"},path.basename(preset_file),"Rename","Cancel")}
      else{let _=desk.confirm(app,if ensemble{"model_preset_delete_confirm"}else{"session_delete_confirm"},if ensemble{"Delete this ensemble preset?"}else{"Delete this session preset?"},preset_file,"Delete preset","Cancel")}}}
     continue}
    if (kind=="prompt" and (id=="session_rename_name" or id=="model_preset_rename_name")) or
       (kind=="confirm" and (id=="session_delete_confirm" or id=="model_preset_delete_confirm")){
     let file:string=ref.swap(preset_file,string.new())
     let digest:string=ref.swap(preset_identity,string.new())
     if array.len(jobs)>0 or str.len(file)==0{continue}
     let ensemble:bool=id=="model_preset_rename_name" or id=="model_preset_delete_confirm"
     if kind=="prompt"{
      if desk.boolean(event,"cancelled"){continue}
      let name:string=desk.field(event,"value")
      let renamed:result<string,string>=if ensemble{presets.rename(file,name,digest)}else{session_presets.rename(file,name,digest)}
      match renamed{ok(destination)=>{let _=desk.set_text(app,"status",text.concat(if ensemble{"Ensemble preset renamed: "}else{"Session preset renamed: "},destination))},err(e)=>{let _=desk.set_text(app,"status",e)}}
     }else{if desk.boolean(event,"confirmed"){
      let removed:result<unit,string>=if ensemble{presets.remove(file,digest)}else{session_presets.remove(file,digest)}
      match removed{ok(_)=>{let _=desk.set_text(app,"status",if ensemble{"Ensemble preset deleted; active settings unchanged"}else{"Session preset deleted; active session unchanged"})},err(e)=>{let _=desk.set_text(app,"status",e)}}}}
     continue}
    if kind=="dialog" and (id=="session_save" or id=="session_open"){
     if array.len(jobs)>0 or desk.boolean(event,"cancelled"){continue}
     let file:string=desk.field(event,"value")
     if str.len(file)==0{continue}
     if id=="session_save"{
      match session_presets.save(state,file){ok(_)=>{let _=desk.set_text(app,"status","Session preset saved with settings and file references")},err(e)=>{let _=desk.set_text(app,"status",e)}}
     }else{
      match session_presets.read(file){err(e)=>{let _=desk.set_text(app,"status",e)},ok(selected)=>{
       let _=listen.stop(app,audition)
       state=selected
       model_editor.close(app,editor)
       preferences_display(app,state,lists,paired)
       cleanup_draft=string.copy(state.cleanup_threshold)
       mask_window_draft=string.copy(state.mask_window)
       mask_aggression_draft=string.copy(state.mask_aggression)
       inference_semitones_draft=string.copy(state.inference_semitones)
       recording_shifts_draft=string.copy(state.recording_shifts)
       recording_overlap_draft=string.copy(state.recording_overlap)
       recording_segment_draft=string.copy(state.recording_segment)
       recording_seed_draft=string.copy(state.recording_seed)
       gpu_index_draft=string.copy(state.gpu_index)
       audition.selection=string.copy(state.input)
       let _=desk.set_text(app,"audio_file",state.input)
       let _=listen.clear_results(app,audition,state.output)
       if str.len(state.output)>0{let _=listen.refresh(app,audition,state.output)}
       if path.is_absolute(state.checkpoint){catalog_state.directory=path.dirname(state.checkpoint)
        let _=desk.set_text(app,"catalog_directory",catalog_state.directory)
        let _=model_panel.refresh(app,catalog_state)}
       preference_dirty=true
       let _=desk.set_text(app,"status","Session preset opened; no processing started")}}
     }
     continue}
    if (kind=="select" or kind=="activate") and id=="catalog_profiles"{
     if array.len(jobs)==0{let selected:string=desk.field(event,"value")
      if option.is_some(model_catalog.find(catalog_state.entries,selected)){
       model_editor.close(app,editor)
       catalog_state.selected=selected
       io.write(text.concat("Model preview: ",text.concat(catalog_state.selected,"\n")))
       model_panel.details(app,catalog_state)}}
     continue}
    if (kind=="change" or kind=="dialog") and id=="catalog_directory"{
     if array.len(jobs)==0 and not desk.boolean(event,"cancelled"){
      model_editor.close(app,editor)
      catalog_state.directory=desk.field(event,"value")
      if kind=="dialog"{let _=desk.set_text(app,"catalog_directory",catalog_state.directory)}
      io.write(text.concat("Model folder: ",text.concat(catalog_state.directory,"\n")))
      let _=desk.set_text(app,"catalog_status","Folder changed. Refresh offline presence or verify the selected model.")}
     continue}
    if (kind=="change" or kind=="dialog") and (id=="alignment_first" or id=="alignment_second"){
     if array.len(jobs)==0 and not desk.boolean(event,"cancelled"){
      let value:string=desk.field(event,"value")
      if id=="alignment_first"{state.alignment_first=string.copy(value)}else{state.alignment_second=string.copy(value)}
      if kind=="dialog"{let _=desk.set_text(app,id,value)}
      preference_dirty=true}
     continue}
    if kind=="change" and (id=="ensemble_activation_file" or id=="queue_activation_file"){
     if array.len(jobs)>0{continue}
     input_activation_file=desk.boolean(event,"value")
     let _=desk.set_bool(app,if id=="ensemble_activation_file"{"queue_activation_file"}else{"ensemble_activation_file"},"active",input_activation_file)
     continue}
    if (kind=="activate" and (id=="ensemble_rows" or id=="queue_rows")) or
     (kind=="action" and (id=="ensemble_open_file" or id=="ensemble_open_folder" or id=="queue_open_file" or id=="queue_open_folder")){
     if array.len(jobs)>0{continue}
     let audio_list:bool=id=="ensemble_rows" or id=="ensemble_open_file" or id=="ensemble_open_folder"
     let key:string=if kind=="activate"{desk.field(event,"value")}else{""}
     let selected:result<string,string>=if audio_list{input_navigation.audio_target(struct.borrow(lists,field=audio),state.ensemble_inputs,key)}else{input_navigation.queue_target(struct.borrow(lists,field=queue),state.queue_items,key)}
     let folder:bool=if kind=="activate"{not input_activation_file}else{id=="ensemble_open_folder" or id=="queue_open_folder"}
     match selected{err(e)=>{let _=desk.set_text(app,"status",e)},ok(file)=>{
      match input_navigation.open(file,folder){ok(_)=>{let _=desk.set_text(app,"status",if folder{"Requested the recording folder in the file manager"}else{"Requested the recording in its default application"})},err(e)=>{let _=desk.set_text(app,"status",e)}}}}
     continue}
    if kind=="selection" and (id=="ensemble_rows" or id=="queue_rows"){
     if array.len(jobs)==0{
      let outcome:result<unit,string>=if id=="ensemble_rows"{input_selection.receive(struct.borrow(lists,field=audio),event)}else{input_selection.receive(struct.borrow(lists,field=queue),event)}
      match outcome{ok(_)=>{},err(e)=>{let _=desk.set_text(app,"status",e)}}}
     continue}
    if array.len(state.queue_items)==0{state.queue_model_snapshot=""
     state.queue_cleanup_snapshot=""
     state.queue_learned_snapshot=""
     state.queue_inference_snapshot=""
     state.queue_recording_snapshot=""
     state.queue_recording_state=""
     state.queue_naming_snapshot=""}
    if model_actions.handles(id,kind){
     let snapshot:string=if id=="model_editor_save" or id=="model_restore"{match capture_models(state){ok(v)=>v,err(e)=>{
      let _=desk.set_text(app,"model_editor_status",e)
      continue}}}else{""}
     match model_actions.receive(app,editor,catalog_state,state,retained,event,root,preference_file,preference_temporary,
      preference_serialized,preference_dirty,preference_writable,snapshot,array.len(jobs)>0){ok(_)=>{},err(e)=>{
       let _=desk.set_text(app,"model_editor_status",e)
       let _=desk.set_text(app,"catalog_status",e)}}
     continue}
    if paired_panel.handles(id,kind){
     match paired_panel.receive(app,state,paired,event,root,array.len(jobs)>0){ok(changed)=>{if changed{preference_dirty=true}},err(error)=>{let _=desk.set_text(app,"status",error)}}
     continue}
    if kind=="change" or kind=="dialog" or kind=="action"{preference_dirty=true}
    if id=="audio_player" and (kind=="video" or kind=="error"){listen.observe(app,audition,event)
     continue}
    if kind=="change"{
     match listen.change(app,audition,event){ok(handled)=>{if handled{continue}},err(e)=>{listen.report(app,e)
      continue}}}
    if (kind=="select" or kind=="activate") and id=="audio_results"{
     let selected:string=desk.field(event,"value")
     if listen.selected(audition,selected){match listen.load(app,audition,selected,kind=="activate"){ok(_)=>{},err(e)=>{listen.report(app,e)}}}
     continue}
    if kind=="dialog" and (id=="audio_choose" or id=="audio_choose_folder"){
     let selected:string=desk.field(event,"value")
     if str.len(selected)==0 or desk.boolean(event,"cancelled"){continue}
     if id=="audio_choose"{match listen.load(app,audition,selected,false){ok(_)=>{},err(e)=>{listen.report(app,e)}}
     }else{match listen.refresh(app,audition,selected){ok(_)=>{},err(e)=>{let _=desk.set_text(app,"audio_results_status",e)}}}
     continue}
    if kind=="action"{
     if id=="listen_page"{show_page(app,state,6.0)
      continue}
     if id=="audio_focus_results"{show_page(app,state,6.0)
      if array.len(audition.files)>0{let first:string=string.copy(array.get(audition.files,0))
       let _=desk.select(app,"audio_results",first)}
      let _=desk.focus(app,"audio_results")
      continue}
     if id=="audio_focus_mute" or id=="audio_focus_seek" or id=="audio_focus_volume"{show_page(app,state,6.0)
      let _=desk.focus(app,if id=="audio_focus_mute"{"audio_muted"}else{if id=="audio_focus_seek"{"audio_seek"}else{"audio_volume"}})
      continue}
     if id=="audio_focus"{show_page(app,state,6.0)
      let _=desk.focus(app,"audio_file")
      continue}
     if id=="audio_choose"{let _=desk.dialog(app,"audio_choose","open","Choose audio to listen to","",root)
      continue}
     if id=="audio_choose_folder" and array.len(jobs)==0{let _=desk.dialog(app,"audio_choose_folder","folder","Choose results folder","",root)
      continue}
     if id=="audio_refresh" and array.len(jobs)==0{match listen.refresh(app,audition,state.output){ok(_)=>{},err(e)=>{let _=desk.set_text(app,"audio_results_status",e)}}
      continue}
     if id=="audio_open_folder"{match listen.open_folder(audition.root){ok(_)=>{let _=desk.set_text(app,"audio_results_status","Requested the results folder in the file manager")},err(e)=>{let _=desk.set_text(app,"audio_results_status",e)}}
      continue}
     if id=="audio_reveal"{match listen.reveal(audition.selection){ok(_)=>{let _=desk.set_text(app,"audio_results_status","Requested the selected file's folder in the file manager")},err(e)=>{let _=desk.set_text(app,"audio_results_status",e)}}
      continue}
     if id=="audio_external"{match listen.open_external(audition.selection){ok(_)=>{let _=desk.set_text(app,"audio_status","Requested the selected audio in its default application")},err(e)=>{listen.report(app,e)}}
      continue}
     if id=="audio_input"{show_page(app,state,6.0)
      match listen.load(app,audition,state.input,true){ok(_)=>{},err(e)=>{listen.report(app,e)}}
      continue}
     if id=="audio_play" or id=="audio_toggle"{
      if id=="audio_toggle" and audition.playing{let _=desk.pause(app,"audio_player",false)
      }else{match listen.play(app,audition){ok(_)=>{},err(e)=>{listen.report(app,e)}}}
      continue}
     if id=="audio_pause"{let _=desk.pause(app,"audio_player",false)
      continue}
     if id=="audio_stop"{match listen.stop(app,audition){ok(_)=>{},err(e)=>{listen.report(app,e)}}
      continue}}
    if kind=="close" or id=="quit"{break}
    if kind=="error"{let _=desk.set_text(app,"status",desk.field(event,"message"))
     continue}
    if kind=="change" or kind=="dialog"{
     let value:string=desk.field(event,"value")
     if kind=="dialog" and (id=="ensemble_sample_library" or id=="queue_sample_library" or id=="mastering_library" or id=="noise_checkpoint" or id=="room_checkpoint") and desk.boolean(event,"cancelled"){continue}
     if id=="processing_sample"{state.processing_sample=desk.boolean(event,"value")
      continue}
     if id=="ensemble_sample_seconds" or id=="queue_sample_seconds" or id=="processing_sample_seconds"{
      if str.view(struct.borrow(state,field=sample_seconds))!=str.view(value){
       state.sample_seconds=string.copy(value)
       if id!="ensemble_sample_seconds"{let _=desk.set_text(app,"ensemble_sample_seconds",value)}
       if id!="queue_sample_seconds"{let _=desk.set_text(app,"queue_sample_seconds",value)}
       if id!="processing_sample_seconds"{let _=desk.set_text(app,"processing_sample_seconds",value)}}
      continue}
     if id=="ensemble_sample_library" or id=="queue_sample_library" or id=="mastering_library"{
      if str.view(struct.borrow(state,field=sample_library))!=str.view(value) or kind=="dialog"{
       state.sample_library=string.copy(value)
       if id!="ensemble_sample_library"{let _=desk.set_text(app,"ensemble_sample_library",value)}
       if id!="queue_sample_library"{let _=desk.set_text(app,"queue_sample_library",value)}
       if id!="mastering_library"{let _=desk.set_text(app,"mastering_library",value)}
       if kind=="dialog"{let _=desk.set_text(app,id,value)}}
      continue}
     if kind=="dialog" and id=="queue_inputs"{
      let chosen:array<string>=desk.dialog_paths(event)
      var i:u64=0
      loop{if i==array.len(chosen){break}
       queue_append(state,array.get(chosen,i))
       i+=1}
      queue_list(app,state.queue_items,lists)
      continue}
     if kind=="dialog" and id=="ensemble_inputs"{
      var chosen:array<string>=desk.dialog_paths(event)
      var i:u64=0
      loop{if i==array.len(chosen){break}
       array.push(state.ensemble_inputs,string.copy(array.get(chosen,i)))
       i+=1}
      ensemble_list(app,state.ensemble_inputs,lists)
      continue}
     if kind=="dialog" and id=="model_preset_save"{
      if str.len(value)==0{continue}
      if array.len(jobs)>0{continue}

      var selected:model_config.Recipe=model_recipe(state)
      match presets.save(selected,value){ok(_)=>{let _=desk.set_text(app,"status","Ensemble preset saved")},err(e)=>{let _=desk.set_text(app,"status",e)}}
      continue}
     if kind=="dialog" and id=="model_preset_open"{
      if str.len(value)==0{continue}
      if array.len(jobs)>0{continue}
      match presets.read(value){err(e)=>{let _=desk.set_text(app,"status",e)},ok(selected)=>{
       state.model_paired=selected.paired
       state.model_primary=selected.primary
       state.model_secondary=selected.secondary
       state.model_wave=selected.wave
       state.model_normalize=selected.recipe.options.normalize
       state.model_keep=selected.recipe.options.keep_members
       state.model_residual=selected.residual
       state.model_spectral=selected.spectral
       state.ensemble_models=struct.replace(struct.borrow(selected,field=recipe),[],field=models)
       state.secondary_rules=[]
       state.preprocess_model=0
       state.vocal_model=0
       model_list(app,state.ensemble_models)
       secondary_list(app,state.secondary_rules)
       preprocess_list(app,0)
       vocal_list(app,0)
       let _=desk.set_number(app,"model_outputs","selected",if state.model_paired{1.0}else{0.0})
       let _=desk.set_number(app,"model_primary","selected",state.model_primary)
       let _=desk.set_number(app,"model_secondary","selected",state.model_secondary)
       let _=desk.set_bool(app,"model_wave","active",state.model_wave)
       let _=desk.set_bool(app,"model_normalize","active",state.model_normalize)
       let _=desk.set_bool(app,"model_keep","active",state.model_keep)
       let _=desk.set_bool(app,"model_residual","active",state.model_residual)
       let _=desk.set_bool(app,"model_spectral","active",state.model_spectral)
       show_page(app,state,1.0)
       let _=desk.set_text(app,"status","Ensemble preset loaded; secondary and vocal assignments cleared")}}
      continue}
     if kind=="dialog" and id=="model_processing"{
      if array.len(state.ensemble_models)>0 and str.len(value)>0{
       let last:u64=array.len(state.ensemble_models)-1
       let attached:result<string,string>=processing_app.attachment(array.borrow(state.ensemble_models,last),value)
       match attached{ok(encoded)=>{let member:ref<model_config.Model>=array.borrow(state.ensemble_models,last)
        member.processing=encoded
        model_list(app,state.ensemble_models)
        let _=desk.set_text(app,"status","Processing attached to the last ensemble member; ensemble output settings apply")},err(e)=>{let _=desk.set_text(app,"status",e)}}}
      continue}
     if id=="settings"{if str.view(state.settings)!=str.view(value){state.model_definition=""
       model_editor.close(app,editor)}
      state.settings=string.copy(str.view(value))}
     if id=="checkpoint"{if str.view(state.checkpoint)!=str.view(value){state.model_definition=""
       model_editor.close(app,editor)}
      state.checkpoint=string.copy(str.view(value))}
     if id=="input"{state.input=string.copy(str.view(value))}
     if id=="tool_amount"{state.tool_amount=string.copy(value)}
     if id=="pitch_amount"{state.pitch_amount=string.copy(value)}
     if id=="tempo_amount"{state.tempo_amount=string.copy(value)}
     if id=="pitch_preserve_amount"{state.pitch_preserve_amount=string.copy(value)}
     if id=="alignment_polarity"{state.alignment_polarity=desk.number(event,"value")}
     if id=="alignment_windows"{state.alignment_windows=desk.number(event,"value")
      export_controls(app,state)}
     if id=="alignment_intros"{state.alignment_intros=desk.number(event,"value")}
     if id=="alignment_gain"{state.alignment_gain=desk.number(event,"value")}
     if id=="alignment_phase"{state.alignment_phase=desk.number(event,"value")}
     if id=="alignment_initial_polarity"{state.alignment_initial_polarity=desk.number(event,"value")}
     if id=="alignment_match_silence"{state.alignment_match_silence=desk.boolean(event,"value")}
     if id=="alignment_spectral_match"{state.alignment_spectral_match=desk.boolean(event,"value")}
     if id=="naming_append_model"{state.naming_append_model=desk.boolean(event,"value")}
     if id=="naming_model_folder"{state.naming_model_folder=desk.boolean(event,"value")}
     if id=="naming_testing"{state.naming_testing=desk.boolean(event,"value")}
     if id=="naming_append_ensemble"{state.naming_append_ensemble=desk.boolean(event,"value")}
     if id=="naming_ensemble_label"{state.naming_ensemble_label=string.copy(value)}
     if id=="export_subtype"{state.export_subtype=desk.number(event,"value")}
     if id=="output_container"{state.output_container=desk.number(event,"value")
      export_controls(app,state)}
     if id=="mp3_bitrate"{state.mp3_bitrate=desk.number(event,"value")}
     if id=="audio_budget"{state.audio_budget=desk.number(event,"value")}
     if id=="codec_directory"{state.codec_directory=string.copy(value)}
     if id=="alignment_save_aligned"{state.alignment_save_aligned=desk.boolean(event,"value")}
     if id=="output"{state.output=string.copy(str.view(value))}
     if id=="gpu"{state.use_gpu=desk.boolean(event,"value")}
     if id=="high_band"{state.high_band=desk.boolean(event,"value")}
     if id=="noise_reduction"{state.noise_reduction=desk.boolean(event,"value")
      if state.noise_reduction and str.len(state.noise_checkpoint)==0{state.noise_checkpoint=path.join(root,"assets/cleanup-noise-v1.pth")
       let _=desk.set_text(app,"noise_checkpoint",state.noise_checkpoint)}}
     if id=="room_reduction"{state.room_reduction=desk.boolean(event,"value")
      if state.room_reduction and str.len(state.room_checkpoint)==0{state.room_checkpoint=path.join(root,"assets/cleanup-room-v1.pth")
       let _=desk.set_text(app,"room_checkpoint",state.room_checkpoint)}}
     if id=="room_targets"{state.room_targets=desk.number(event,"value")}
     if id=="noise_checkpoint"{state.noise_checkpoint=string.copy(value)}
     if id=="room_checkpoint"{state.room_checkpoint=string.copy(value)}
     if id=="cleanup_enabled"{state.cleanup_enabled=desk.boolean(event,"value")
      let _=desk.set_bool(app,"cleanup_threshold","sensitive",state.cleanup_enabled)}
     if id=="cleanup_threshold"{cleanup_draft=string.copy(value)
      match cleanup_policy.edit_threshold(value,state.cleanup_threshold){ok(accepted)=>{state.cleanup_threshold=accepted},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="gpu_index"{gpu_index_draft=string.copy(value)
      match device_selection.parse(value){ok(_)=>{state.gpu_index=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="inference_pitch"{state.inference_pitch=desk.boolean(event,"value")}
     if id=="match_frequency"{state.match_frequency=desk.boolean(event,"value")}
     if id=="inference_semitones"{inference_semitones_draft=string.copy(value)
      match recording_policy.current_with_pitch(false,"2",true,"0.25","Default","Random",true,value,false){ok(_)=>{state.inference_semitones=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="recording_override"{state.recording_override=desk.boolean(event,"value")}
     if id=="recording_split"{state.recording_split=desk.boolean(event,"value")}
     if id=="recording_shifts"{recording_shifts_draft=string.copy(value)
      match recording_policy.current(true,value,state.recording_split,recording_overlap_draft,recording_segment_draft,recording_seed_draft){ok(_)=>{state.recording_shifts=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="recording_overlap"{recording_overlap_draft=string.copy(value)
      match recording_policy.current(true,recording_shifts_draft,state.recording_split,value,recording_segment_draft,recording_seed_draft){ok(_)=>{state.recording_overlap=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="recording_segment"{recording_segment_draft=string.copy(value)
      match recording_policy.current(true,recording_shifts_draft,state.recording_split,recording_overlap_draft,value,recording_seed_draft){ok(_)=>{state.recording_segment=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="recording_seed"{recording_seed_draft=string.copy(value)
      match recording_policy.current(true,recording_shifts_draft,state.recording_split,recording_overlap_draft,recording_segment_draft,value){ok(_)=>{state.recording_seed=string.copy(value)},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="mask_tta"{state.mask_tta=desk.number(event,"value")}
     if id=="mask_window"{mask_window_draft=string.copy(value)
      match inference_policy.edit_window(value,state.mask_window){ok(accepted)=>{state.mask_window=accepted},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="mask_aggression"{mask_aggression_draft=string.copy(value)
      match inference_policy.edit_aggression(value,state.mask_aggression){ok(accepted)=>{state.mask_aggression=accepted},err(problem)=>{let _=desk.set_text(app,"status",problem)}}}
     if id=="ensemble_wave"{state.ensemble_wave=desk.boolean(event,"value")}
     if id=="ensemble_normalize"{state.ensemble_normalize=desk.boolean(event,"value")}
     if id=="model_outputs"{state.model_paired=desk.number(event,"value")==1.0}
     if id=="model_primary"{state.model_primary=desk.number(event,"value")}
     if id=="model_secondary"{state.model_secondary=desk.number(event,"value")}
     if id=="model_wave"{state.model_wave=desk.boolean(event,"value")}
     if id=="model_normalize"{state.model_normalize=desk.boolean(event,"value")}
     if id=="model_keep"{state.model_keep=desk.boolean(event,"value")}
     if id=="single_outputs"{state.single_outputs=desk.number(event,"value")}
     if id=="single_complement"{state.single_complement=desk.number(event,"value")}
     if id=="single_normalize"{state.single_normalize=desk.boolean(event,"value")}
     if id=="single_keep"{state.single_keep=desk.boolean(event,"value")}
     if id=="model_residual"{state.model_residual=desk.boolean(event,"value")
      if state.model_residual{state.model_spectral=false
       let _=desk.set_bool(app,"model_spectral","active",false)}}
     if id=="model_spectral"{state.model_spectral=desk.boolean(event,"value")
      if state.model_spectral{state.model_residual=false
       let _=desk.set_bool(app,"model_residual","active",false)}}
     if id=="queue_continue"{state.queue_continue=desk.boolean(event,"value")}
     if id=="secondary_target"{state.secondary_target=desk.number(event,"value")}
     if id=="secondary_weight"{state.secondary_weight=string.copy(value)}
     if id=="secondary_outputs" or id=="vocal_outputs"{state.secondary_outputs=desk.number(event,"value")
      let _=desk.set_number(app,if id=="secondary_outputs"{"vocal_outputs"}else{"secondary_outputs"},"selected",state.secondary_outputs)}
     if id=="secondary_normalize" or id=="vocal_normalize"{state.secondary_normalize=desk.boolean(event,"value")
      let _=desk.set_bool(app,if id=="secondary_normalize"{"vocal_normalize"}else{"secondary_normalize"},"active",state.secondary_normalize)}
     if id=="secondary_keep" or id=="vocal_keep"{state.secondary_keep=desk.boolean(event,"value")
      let _=desk.set_bool(app,if id=="secondary_keep"{"vocal_keep"}else{"secondary_keep"},"active",state.secondary_keep)}
     if id=="vocal_amount"{state.vocal_weight=string.copy(value)}
     if id=="vocal_mixes"{state.vocal_options.mixes=desk.boolean(event,"value")}
     if id=="vocal_mix_only"{state.vocal_options.mix_only=desk.boolean(event,"value")
      if state.vocal_options.mix_only{state.vocal_options.mixes=true
       state.vocal_options.vocal_only=false
       let _=desk.set_bool(app,"vocal_mixes","active",true)
       let _=desk.set_bool(app,"vocal_save_only","active",false)}}
     if id=="vocal_save_only"{state.vocal_options.vocal_only=desk.boolean(event,"value")
      if state.vocal_options.vocal_only{state.vocal_options.mix_only=false
       let _=desk.set_bool(app,"vocal_mix_only","active",false)}}
     if id=="secondary_residual"{state.secondary_residual=desk.boolean(event,"value")
      if state.secondary_residual{state.secondary_spectral=false
       let _=desk.set_bool(app,"secondary_spectral","active",false)}}
     if id=="secondary_spectral"{state.secondary_spectral=desk.boolean(event,"value")
      if state.secondary_spectral{state.secondary_residual=false
       let _=desk.set_bool(app,"secondary_residual","active",false)}}
     if id=="preprocess_residual"{state.preprocess_residual=desk.boolean(event,"value")
      if state.preprocess_residual{state.preprocess_spectral=false
       let _=desk.set_bool(app,"preprocess_spectral","active",false)}}
     if id=="preprocess_spectral"{state.preprocess_spectral=desk.boolean(event,"value")
      if state.preprocess_spectral{state.preprocess_residual=false
       let _=desk.set_bool(app,"preprocess_residual","active",false)}}
     if id=="preprocess_extra"{state.preprocess_extra=desk.boolean(event,"value")}
     if kind=="dialog"{let _=desk.set_text(app,str.view(id),str.view(value))}
    }
    if kind!="action"{continue}
    if id=="cancel" and array.len(jobs)>0{let _=files.write_text(str.view(cancel),"cancel")
     let _=desk.set_text(app,"status","Cancelling after the current operation…")
     continue}
    if array.len(jobs)>0{continue}
    if id=="choose_noise_checkpoint" or id=="choose_room_checkpoint"{
     let _=desk.dialog(app,if id=="choose_noise_checkpoint"{"noise_checkpoint"}else{"room_checkpoint"},"open",if id=="choose_noise_checkpoint"{"Choose noise reduction weights"}else{"Choose room reduction weights"},"",root)
     continue}
    if id=="ensemble_sample_library_pick" or id=="queue_sample_library_pick" or id=="mastering_library_pick"{
     let _=desk.dialog(app,if id=="mastering_library_pick"{"mastering_library"}else{if id=="ensemble_sample_library_pick"{"ensemble_sample_library"}else{"queue_sample_library"}},"open","Choose sound-file decoder library","",root)
     continue}
    if id=="ensemble_sample" or id=="queue_sample"{
     let queued:bool=id=="queue_sample"
     let selected:array<sample.Selection>=match if queued{
