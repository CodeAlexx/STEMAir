     let _=files.remove(progress)
     previous_progress=string.new()
     let work:job.SecondaryWork=job.SecondaryWork{application_root:string.copy(root),mask_high_band:mask_policy.checkbox(state.high_band),mask_controls:string.copy(selected_inference),learned_controls:string.copy(selected_learned),recording_controls:string.copy(selected_recording),gpu_index:selected_device,mask_cleanup:selected_cleanup.enabled,mask_cleanup_threshold:selected_cleanup.threshold,codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:ref.swap(retained,option.none()),settings:recipe,input:string.copy(state.input),output:string.copy(state.output),
