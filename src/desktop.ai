     array.push(jobs,task.spawn(audio_jobs.Secondary{work:option.some(work),policy:ref.swap(input_policy,option.none()),sample:ref.swap(sample_policy,option.none()),naming_snapshot:naming_snapshot},fn=audio_jobs.run_Secondary))
     busy(app,true)
     let _=desk.set_text(app,"status",if state.vocal_model>0{"Preparing vocal chain…"}else{"Preparing secondary models…"})}
    if id=="model_run"{
     let recipe:model_config.Recipe=model_recipe(state)
     let naming_snapshot:string=match naming.ensemble(state,recipe){ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
      continue}}
     let _=files.remove(cancel)
     let _=files.remove(progress)
     previous_progress=string.new()
     let work:job.ModelEnsembleWork=job.ModelEnsembleWork{application_root:string.copy(root),mask_high_band:mask_policy.checkbox(state.high_band),mask_controls:string.copy(selected_inference),learned_controls:string.copy(selected_learned),recording_controls:string.copy(selected_recording),gpu_index:selected_device,mask_cleanup:selected_cleanup.enabled,mask_cleanup_threshold:selected_cleanup.threshold,codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:ref.swap(retained,option.none()),settings:recipe,
      input:string.copy(state.input),output:string.copy(state.output),cancel:string.copy(cancel),progress:string.copy(progress),use_gpu:state.use_gpu}
     array.push(jobs,task.spawn(audio_jobs.ModelEnsemble{work:option.some(work),policy:ref.swap(input_policy,option.none()),sample:ref.swap(sample_policy,option.none()),naming_snapshot:naming_snapshot},fn=audio_jobs.run_ModelEnsemble))
     busy(app,true)
     let _=desk.set_text(app,"status","Preparing selected models…")}
    if id=="ensemble_min" or id=="ensemble_max" or id=="ensemble_average"{
     var inputs:array<string>=[]
     var i:u64=0
     loop{if i==array.len(state.ensemble_inputs){break}
      array.push(inputs,string.copy(array.get(state.ensemble_inputs,i)))
      i+=1}
     let ensemble_settings:ensemble_app.Settings=ensemble_app.Settings{inputs:inputs,
      method:if id=="ensemble_min"{"minimum"}else{if id=="ensemble_max"{"maximum"}else{"average"}},
      domain:if state.ensemble_wave{"waveform"}else{"spectrum"},normalize:state.ensemble_normalize}
     let _=files.remove(cancel)
     let _=files.remove(progress)
     previous_progress=string.new()
     let work:job.EnsembleWork=job.EnsembleWork{codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:ref.swap(retained,option.none()),settings:ensemble_settings,
      output:string.copy(state.output),cancel:string.copy(cancel),progress:string.copy(progress)}
     array.push(jobs,task.spawn(audio_jobs.Ensemble{work:option.some(work),policy:ref.swap(input_policy,option.none())},fn=audio_jobs.run_Ensemble))
     busy(app,true)
     let _=desk.set_text(app,"status","Combining selected audio…")}
    if id=="reload"{match cpu_close.retained_all(retained){err(e)=>{let _=desk.set_text(app,"status",e)
      continue},ok(_)=>{}}
     let _=desk.set_text(app,"status","Models released. They will load for the next recording.")}
    if id=="separate"{
     let _=files.remove(str.view(cancel))
     let _=files.remove(str.view(progress))
     previous_progress=string.new()
     if state.single_outputs!=0.0 or state.single_complement!=0.0 or state.single_normalize or state.single_keep{
      let recipe:secondary_config.Recipe=single_recipe(state.settings,state.checkpoint,state.single_outputs,state.single_complement,state.single_normalize,state.single_keep)
      let definition:string=string.copy(state.model_definition)
      let naming_snapshot:string=match naming.secondary(state,recipe,definition){ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
       continue}}
      let work:job.SecondaryWork=job.SecondaryWork{application_root:string.copy(root),mask_high_band:mask_policy.checkbox(state.high_band),mask_controls:string.copy(selected_inference),learned_controls:string.copy(selected_learned),recording_controls:string.copy(selected_recording),gpu_index:selected_device,mask_cleanup:selected_cleanup.enabled,mask_cleanup_threshold:selected_cleanup.threshold,codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:ref.swap(retained,option.none()),settings:recipe,input:string.copy(state.input),output:string.copy(state.output),cancel:string.copy(cancel),progress:string.copy(progress),use_gpu:state.use_gpu}
      array.push(jobs,task.spawn(audio_jobs.Secondary{work:option.some(work),policy:ref.swap(input_policy,option.none()),sample:ref.swap(sample_policy,option.none()),naming_snapshot:naming_snapshot},fn=audio_jobs.run_Secondary))
      busy(app,true)
      let _=desk.set_text(app,"status","Preparing selected sources…")
      continue}
     let naming_snapshot:string=match naming.single(state){ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
      continue}}
     let payload:job.Work=job.Work{application_root:string.copy(root),mask_high_band:mask_policy.checkbox(state.high_band),mask_controls:string.copy(selected_inference),learned_controls:string.copy(selected_learned),recording_controls:string.copy(selected_recording),gpu_index:selected_device,mask_cleanup:selected_cleanup.enabled,mask_cleanup_threshold:selected_cleanup.threshold,codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:ref.swap(retained,option.none()),settings:string.copy(str.view(state.settings)),checkpoint:string.copy(str.view(state.checkpoint)),input:string.copy(str.view(state.input)),output:string.copy(str.view(state.output)),cancel:string.copy(str.view(cancel)),progress:string.copy(str.view(progress)),use_gpu:state.use_gpu}
     array.push(jobs,task.spawn(audio_jobs.Single{work:option.some(payload),policy:ref.swap(input_policy,option.none()),sample:ref.swap(sample_policy,option.none()),naming_snapshot:naming_snapshot},fn=audio_jobs.run_Single))
     busy(app,true)
     let _=desk.set_text(app,"status","Preparing recording…")
    }
   }
  },}
  if array.len(jobs)>0{let _=files.write_text(str.view(cancel),"cancel")
   let _=desk.set_text(app,"status","Finishing the current operation before closing…")
   loop{match array.pop(jobs){none=>{break},some(handle)=>{
    var finished:job.Completed=task.join(handle)
    match cpu_close.retained_all(struct.borrow(finished,field=retained)){ok(_)=>{},err(e)=>{io.ewrite(text.concat("Session close failed while ending the application: ",e))}}}}}}
  match cpu_close.retained_all(retained){ok(_)=>{},err(e)=>{io.ewrite(text.concat("Session close failed while ending the application: ",e))}}
  let _=desk.clear_video(app,"audio_player")
  desk.close(app)
  let _=proc.settle(helpers,str.view(app.root),2000,300)
 }
 let _=files.remove(cancel)
 let _=files.remove(progress)
 let _=files.remove(text.concat(progress,".tmp"))
 let _=files.remove(text.concat(progress,".queue"))
 let _=files.remove(text.concat(progress,".queue.tmp"))
 desk.cleanup(app)
 answer
}
