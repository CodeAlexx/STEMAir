     selected_learned=match learned_policy.current(state.noise_reduction,state.room_reduction,state.room_targets,state.noise_checkpoint,state.room_checkpoint){ok(value)=>value,err(problem)=>{
      let _=desk.set_text(app,"status",problem)
      continue}}}
    if processing_action(id) and (not (id=="queue_single" or id=="queue_ensemble" or id=="queue_secondary") or str.len(state.queue_model_snapshot)==0){
     let recording_raw:string=match recording_policy.current_with_pitch(state.recording_override,recording_shifts_draft,state.recording_split,recording_overlap_draft,recording_segment_draft,recording_seed_draft,state.inference_pitch,inference_semitones_draft,state.match_frequency){ok(value)=>value,err(problem)=>{
      let _=desk.set_text(app,"status",problem)
