     }else{sample_panel.audio(struct.borrow(lists,field=audio),struct.borrow(state,field=ensemble_inputs))}{
      ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
       continue}}
     audio_request+=1
     let scratch:string=path.join(app.root,text.concat("sample-",string.from_int(audio_request)))
     let options:sample.Options=match sample_runtime.options(root,state.codec_directory,state.sample_library,state.sample_seconds,state.output,cast.sat(state.audio_budget),scratch,cancel){
      ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
       continue}}
     let work:sample_job.Work=sample_job.Work{retained:ref.swap(retained,option.none()),selection:selected,queue:queued,
      generation:if queued{lists.queue.generation}else{lists.audio.generation},options:options,progress:string.copy(progress)}
     let _=files.remove(cancel)
     let _=files.remove(progress)
     previous_progress=""
     let _=desk.set_text(app,if queued{"queue_verification_details"}else{"ensemble_verification_details"},"Creating selected recording samples…")
     array.push(jobs,task.spawn(work,fn=desktop_sample_job.run))
     busy(app,true)
     let _=desk.set_text(app,"status","Creating selected recording samples…")
     continue}
    if id=="ensemble_verify" or id=="queue_verify"{
     let queued:bool=id=="queue_verify"
     var inputs:array<string>=[]
     var i:u64=0
     if queued{loop{if i==array.len(state.queue_items){break}
      array.push(inputs,string.copy(array.borrow(state.queue_items,i).input))
      i+=1}}else{loop{if i==array.len(state.ensemble_inputs){break}
      array.push(inputs,string.copy(array.get(state.ensemble_inputs,i)))
      i+=1}}
     if array.len(inputs)==0{let _=desk.set_text(app,"status","No inputs to verify")
      continue}
     audio_request+=1
     let scratch:string=path.join(app.root,text.concat("verify-",string.from_int(audio_request)))
     let policy:checked_input.Options=match audio_io.input(root,state.codec_directory,cast.sat(state.audio_budget),scratch,cancel){
      ok(value)=>value,err(e)=>{let _=desk.set_text(app,"status",e)
       continue}}
     let work:verification_job.Work=verification_job.Work{retained:ref.swap(retained,option.none()),inputs:inputs,
      queue:queued,generation:if queued{lists.queue.generation}else{lists.audio.generation},policy:policy,progress:string.copy(progress)}
     let _=files.remove(cancel)
     let _=files.remove(progress)
     previous_progress=""
     let _=desk.set_text(app,if queued{"queue_verification_details"}else{"ensemble_verification_details"},"Verifying all listed recordings…")
     array.push(jobs,task.spawn(work,fn=verification_job.run))
     busy(app,true)
     let _=desk.set_text(app,"status","Verifying all listed recordings…")
     continue}
    if id=="pairs_accept"{
     match paired_runtime.accept(state,root){err(error)=>{let _=desk.set_text(app,"status",error)},ok(raw)=>{
