     loop{if i==array.len(state.secondary_rules){break}
      let rule:ref<secondary_config.Adjustment>=array.borrow(state.secondary_rules,i)
      if rule.model<array.len(state.ensemble_models){array.push(valid,secondary_config.Adjustment{target:string.copy(rule.target),model:rule.model,primary_weight:rule.primary_weight})}
      i+=1}
     state.secondary_rules=valid
     if state.preprocess_model>=array.len(state.ensemble_models){state.preprocess_model=0}
     if state.vocal_model>=array.len(state.ensemble_models){state.vocal_model=0}
     vocal_list(app,state.vocal_model)
     preprocess_list(app,state.preprocess_model)
     secondary_list(app,state.secondary_rules)
     model_list(app,state.ensemble_models)}
    if id=="model_clear" or id=="secondary_model_clear" or id=="vocal_model_clear"{state.ensemble_models=[]
     state.secondary_rules=[]
     state.preprocess_model=0
     state.vocal_model=0
     vocal_list(app,state.vocal_model)
     preprocess_list(app,state.preprocess_model)
     secondary_list(app,state.secondary_rules)
     model_list(app,state.ensemble_models)}
    if id=="secondary_clear"{state.secondary_rules=[]
     secondary_list(app,state.secondary_rules)}
    if id=="preprocess_assign"{
     if array.len(state.ensemble_models)<2{let _=desk.set_text(app,"status","Add the primary model first, then a two-source vocal/instrumental preprocessor")
      continue}
     state.preprocess_model=array.len(state.ensemble_models)-1
     preprocess_list(app,state.preprocess_model)}
    if id=="preprocess_clear"{state.preprocess_model=0
     preprocess_list(app,state.preprocess_model)}
    if id=="vocal_assign"{
     if array.len(state.ensemble_models)<2{let _=desk.set_text(app,"status","Add the primary model first, then a lead/backing vocal splitter")
      continue}
     state.vocal_model=array.len(state.ensemble_models)-1
     state.secondary_outputs=1.0
     let _=desk.set_number(app,"secondary_outputs","selected",1.0)
     let _=desk.set_number(app,"vocal_outputs","selected",1.0)
     vocal_list(app,state.vocal_model)}
    if id=="vocal_clear"{state.vocal_model=0
     vocal_list(app,state.vocal_model)}
    if id=="secondary_assign"{
     if array.len(state.ensemble_models)<2{let _=desk.set_text(app,"status","Add a primary model first, then at least one secondary model")
      continue}
     let weight:f64=match text.parse_f64(state.secondary_weight){some(v)=>v,none=>{
      let _=desk.set_text(app,"status","Enter a primary weight between 0 and 1")
      continue}}
     if not fp.is_finite(weight) or weight<0.0 or weight>1.0{let _=desk.set_text(app,"status","Enter a primary weight between 0 and 1")
      continue}
     let target:str=secondary_name(state.secondary_target)
     let next:secondary_config.Adjustment=secondary_config.Adjustment{target:string.copy(target),model:array.len(state.ensemble_models)-1,primary_weight:weight}
     var found:option<u64>=option.none()
     var i:u64=0
     loop{if i==array.len(state.secondary_rules){break}
      if str.view(array.borrow(state.secondary_rules,i).target)==target{found=option.some(i)}
