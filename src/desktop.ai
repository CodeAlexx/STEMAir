      let _=desk.set_text(app,"status",e)
      continue}}
     let selection:option<alignment_choices.Recipe>=if state.alignment_windows==2.0 and state.alignment_intros==0.0 and state.alignment_gain==2.0 and state.alignment_phase==0.0 and state.alignment_initial_polarity==0.0 and state.alignment_match_silence and not state.alignment_spectral_match{option.none()}else{option.some(recipe)}
     let _=files.remove(cancel)
     let _=files.remove(progress)
     previous_progress=string.new()
