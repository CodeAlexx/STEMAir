     let _=desk.focus(app,"catalog_profiles")}
    if id=="catalog_choose"{let _=desk.dialog(app,"catalog_directory","folder","Choose model folder","",catalog_state.directory)}
    if id=="catalog_refresh"{match model_panel.refresh(app,catalog_state){ok(_)=>{let _=desk.set_text(app,"catalog_status","Offline model presence refreshed; select Verify to check identity")},err(e)=>{let _=desk.set_text(app,"catalog_status",e)}}}
