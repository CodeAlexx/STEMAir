     let payload:job.CatalogWork=job.CatalogWork{retained:ref.swap(retained,option.none()),request:request,cancel:string.copy(cancel),progress:string.copy(progress)}
     array.push(jobs,task.spawn(payload,fn=job.run_catalog))
     catalog_active=true
