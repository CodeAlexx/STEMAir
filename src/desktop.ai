       continue}
      array.push(references,string.copy(state.alignment_first))
      array.push(targets,string.copy(state.alignment_second))
     }else{
      var row:u64=0
      loop{if row==array.len(state.paired_first_inputs){break}
       array.push(references,string.copy(array.get(state.paired_first_inputs,row)))
       row+=1}
      row=0
