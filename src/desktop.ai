     selected_inference=match inference_policy.current(state.mask_tta,mask_window_draft,mask_aggression_draft){ok(value)=>value,err(problem)=>{
      let _=desk.set_text(app,"status",problem)
      continue}}
     selected_cleanup=match cleanup_policy.current(state.cleanup_enabled,cleanup_draft){ok(value)=>value,err(problem)=>{
      let _=desk.set_text(app,"status",problem)
      continue}}}
    let codec_recipe:string=if processing_action(id){match codec_runtime.settings(root,state.codec_directory,
     cast.sat(state.output_container),cast.sat(state.export_subtype),cast.sat(state.mp3_bitrate)){ok(v)=>v,err(e)=>{
      let _=desk.set_text(app,"status",e)
      continue}}}else{""}
    var input_policy:option<checked_input.Options>=option.none()
    var sample_policy:option<sample.Options>=option.none()
    var output_limits:compressed_export.Limits=compressed_export.Limits{max_frames:0,max_stage_bytes:0,max_encoded_bytes:0}
    if processing_action(id){
     audio_request+=1
     let scratch:string=path.join(app.root,text.concat("decode-",string.from_int(audio_request)))
     input_policy=option.some(match audio_io.input(root,state.codec_directory,cast.sat(state.audio_budget),scratch,cancel){ok(value)=>value,err(e)=>{
      let _=desk.set_text(app,"status",e)
      continue}})
     if state.processing_sample and sample_processing_action(id){
      sample_policy=option.some(match sample_runtime.options(root,state.codec_directory,state.sample_library,state.sample_seconds,state.output,cast.sat(state.audio_budget),scratch,cancel){ok(value)=>value,err(e)=>{
       let _=desk.set_text(app,"status",e)
       continue}})}
     output_limits=match audio_io.output(cast.sat(state.audio_budget),str.len(codec_recipe)>0){ok(value)=>value,err(e)=>{
      let _=desk.set_text(app,"status",e)
      continue}}}
    if id=="focus_tempo_amount" or id=="focus_pitch_preserve_amount"{
     show_page(app,state,2.0)
     let _=desk.focus(app,if id=="focus_tempo_amount"{"tempo_amount"}else{"pitch_preserve_amount"})}
    if id=="tool_tempo" or id=="tool_pitch_preserve"{
     if (str.len(state.input)==0 and array.len(state.queue_items)==0) or str.len(state.output)==0{
      let _=desk.set_text(app,"status","Choose a recording and an existing output folder")
      continue}
     let parsed:option<f64>=if id=="tool_tempo"{text.parse_f64(state.tempo_amount)}else{text.parse_f64(state.pitch_preserve_amount)}
     let amount:f64=match parsed{some(v)=>v,none=>{
      let _=desk.set_text(app,"status",if id=="tool_tempo"{"Enter a tempo greater than zero and at most 10"}else{"Enter a pitch shift between -10 and 10 semitones"})
      continue}}
     var work:job.TimeWork=job.TimeWork{codec_recipe:string.copy(codec_recipe),wav_choice:cast.sat(state.export_subtype),export_max_frames:output_limits.max_frames,export_max_stage_bytes:output_limits.max_stage_bytes,export_max_encoded_bytes:output_limits.max_encoded_bytes,retained:option.none(),
      settings:match time_runtime.settings(root,if id=="tool_tempo"{"tempo"}else{"pitch-preserve-duration"},amount,state.ensemble_normalize){ok(v)=>v,err(e)=>{
       let _=desk.set_text(app,"status",e)
       continue}},input:string.copy(state.input),output:string.copy(state.output),cancel:string.copy(cancel),progress:string.copy(progress)}
     if array.len(state.queue_items)>0{
