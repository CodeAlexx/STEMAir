fn busy(app:ref<desk.Session>,value:bool)->unit effects {alloc,net,time} {
 let ids:array<string>=["session_save","session_open","preferences_save","preferences_reset","audio_refresh","audio_choose_folder","settings","checkpoint","input","output","choose_settings","choose_checkpoint","choose_input","choose_output","gpu","gpu_index","high_band","cleanup_enabled","cleanup_threshold","noise_reduction","room_reduction","room_targets","noise_checkpoint","room_checkpoint","choose_noise_checkpoint","choose_room_checkpoint","mask_tta","mask_window","mask_aggression","inference_pitch","inference_semitones","match_frequency","recording_override","recording_shifts","recording_split","recording_overlap","recording_segment","recording_seed","reload","separate","single_outputs","single_complement","single_normalize","single_keep",
  "ensemble_add","ensemble_current","ensemble_remove","ensemble_swap","ensemble_clear","ensemble_wave","ensemble_normalize","ensemble_min","ensemble_max","ensemble_average","tool_combine","tool_mix","tool_reduce","tool_spectral","tool_amount","tool_pitch","pitch_amount",
  "alignment_first","alignment_first_pick","alignment_second","alignment_second_pick","alignment_polarity","alignment_save_aligned","alignment_run","recording_alignment_run","mastering_run","mastering_pairs_run","mastering_library","mastering_library_pick",
  "pairs_first_rows","pairs_second_rows","pairs_first_add","pairs_second_add","pairs_first_up","pairs_second_up","pairs_first_down","pairs_second_down","pairs_first_duplicate","pairs_second_duplicate","pairs_first_remove","pairs_second_remove","pairs_first_transfer","pairs_second_transfer","pairs_first_clear","pairs_second_clear","pairs_continue","pairs_accept","pairs_run","pairs_remaining",
  "alignment_windows","alignment_intros","alignment_gain","alignment_phase","alignment_initial_polarity","alignment_match_silence","alignment_spectral_match",
  "tempo_amount","pitch_preserve_amount","tool_tempo","tool_pitch_preserve","export_subtype","output_container","mp3_bitrate","codec_directory","choose_codec_directory",
  "model_add","model_remove","model_clear","model_processing_add","model_processing_clear","model_preset_save","model_preset_open","model_outputs","model_primary","model_secondary","model_wave","model_normalize","model_keep","model_residual","model_spectral","model_run",
  "queue_add","queue_current","queue_remove","queue_clear","queue_continue","queue_single","queue_ensemble","queue_secondary",
  "session_rename","session_delete","model_preset_rename","model_preset_delete",
  "audio_budget","ensemble_rows","ensemble_remove_selected","ensemble_keep_selected","queue_rows","queue_remove_selected","queue_keep_selected",
  "ensemble_open_file","ensemble_open_folder","queue_open_file","queue_open_folder",
  "ensemble_activation_file","queue_activation_file",
  "ensemble_verify","queue_verify","ensemble_sample","queue_sample",
  "ensemble_sample_seconds","queue_sample_seconds","ensemble_sample_library","queue_sample_library","ensemble_sample_library_pick","queue_sample_library_pick",
  "processing_sample","processing_sample_seconds","naming_append_model","naming_model_folder","naming_testing","naming_append_ensemble","naming_ensemble_label",
  "secondary_model_add","secondary_model_remove","secondary_model_clear","secondary_target","secondary_weight","secondary_assign","secondary_clear","secondary_outputs","secondary_normalize","secondary_keep","secondary_residual","secondary_spectral","secondary_run",
  "preprocess_assign","preprocess_clear","preprocess_residual","preprocess_spectral","preprocess_extra",
  "model_edit","model_restore","model_editor","queue_use_settings","catalog_profiles","catalog_directory","catalog_choose","catalog_refresh","catalog_verify","catalog_use","catalog_acquire",
  "vocal_model_add","vocal_model_remove","vocal_model_clear","vocal_assign","vocal_clear","vocal_amount","vocal_mixes","vocal_mix_only","vocal_save_only","vocal_outputs","vocal_normalize","vocal_keep","vocal_run"]
 var i:u64=0
 loop{if i>=array.len(ids){break}
  let _=desk.set_bool(app,array.get(ids,i),"sensitive",not value)
  i+=1}
 let _=desk.set_bool(app,"cancel","sensitive",value)
 ()
}
fn export_controls(app:ref<desk.Session>,state:ref<preferences.State>)->unit effects {alloc,net,time} {
 let _=desk.set_bool(app,"alignment_phase","sensitive",state.alignment_windows!=10.0)
 let _=desk.set_bool(app,"mp3_bitrate","sensitive",state.output_container==2.0)
 let _=desk.set_bool(app,"codec_directory","sensitive",true)
 let _=desk.set_bool(app,"choose_codec_directory","sensitive",true)
 ()
}
fn processing_action(id:str)->bool effects {} {
 id=="separate" or id=="secondary_run" or id=="vocal_run" or id=="model_run" or
 id=="ensemble_min" or id=="ensemble_max" or id=="ensemble_average" or
 id=="tool_pitch" or id=="tool_combine" or id=="tool_mix" or id=="tool_reduce" or id=="tool_spectral" or
 id=="tool_tempo" or id=="tool_pitch_preserve" or id=="alignment_run" or id=="recording_alignment_run" or
 id=="queue_single" or id=="queue_ensemble" or id=="queue_secondary"
}
fn sample_processing_action(id:str)->bool effects {} {
 id=="separate" or id=="secondary_run" or id=="vocal_run" or id=="model_run" or
 id=="tool_pitch" or id=="tool_tempo" or id=="tool_pitch_preserve" or
 id=="queue_single" or id=="queue_ensemble" or id=="queue_secondary"
}
fn ensemble_list(app:ref<desk.Session>,inputs:ref<array<string>>,lists:ref<input_lists.State>)->unit effects {alloc,net,time} {
 input_lists.audio(app,struct.borrow(lists,field=audio),inputs)
}
fn model_list(app:ref<desk.Session>,models:ref<array<model_config.Model>>)->unit effects {alloc,net,time} {
 var label:string=text.concat(string.from_int(array.len(models))," models selected")
 var annotated:string=string.copy(label)
 var i:u64=0
 loop{if i==array.len(models) or i==3{break}
  let model:ref<model_config.Model>=array.borrow(models,i)
  let row:string=text.concat("\n",text.concat(string.from_int(i+1),text.concat(". ",text.concat(path.basename(model.config),text.concat(" — ",path.basename(model.checkpoint))))))
  string.append(label,row)
  string.append(annotated,row)
  if str.len(model.processing)>0{string.append(annotated," (processing attached)")}
  i+=1}
 if array.len(models)>3{
  let rest:string=text.concat("\n…and ",text.concat(string.from_int(array.len(models)-3)," more"))
  string.append(label,rest)
  string.append(annotated,rest)}
 let _=desk.set_text(app,"model_inputs",annotated)
 let _=desk.set_text(app,"secondary_models",label)
 let _=desk.set_text(app,"vocal_models",label)
 ()
}
fn secondary_name(index:f64)->str effects {} {
 if index==1.0{"instrumental"}else{if index==2.0{"bass"}else{if index==3.0{"drums"}else{if index==4.0{"other"}else{"vocals"}}}}
}
fn secondary_list(app:ref<desk.Session>,rules:ref<array<secondary_config.Adjustment>>)->unit effects {alloc,net,time} {
 var label:string="Secondary assignments:"
 var i:u64=0
 loop{if i==array.len(rules){break}
  let rule:ref<secondary_config.Adjustment>=array.borrow(rules,i)
  string.append(label,text.concat("\n",text.concat(rule.target,text.concat(" ← model ",text.concat(string.from_int(rule.model+1),text.concat(", primary weight ",string.from_float(rule.primary_weight)))))))
  i+=1}
 if array.len(rules)==0{string.append(label," none")}
 let _=desk.set_text(app,"secondary_rules",label)
 ()
}
fn preprocess_list(app:ref<desk.Session>,index:u64)->unit effects {alloc,net,time} {
 let label:string=if index==0{"Instrumental preprocessing: disabled"}else{text.concat("Preprocess with model ",text.concat(string.from_int(index+1),"; separate instrumental input, then restore original-recording vocals."))}
 let _=desk.set_text(app,"preprocess_summary",label)
 ()
}
fn vocal_list(app:ref<desk.Session>,index:u64)->unit effects {alloc,net,time} {
 let label:string=if index==0{"Vocal splitting: disabled"}else{text.concat("Split primary vocals with model ",string.from_int(index+1))}
 let _=desk.set_text(app,"vocal_summary",label)
 ()
}
fn vocal_amount(settings:ref<vocal.Settings>,value:str)->result<unit,string> effects {alloc} {
 let amount:f64=match text.parse_f64(value){some(v)=>v,none=>{return result.err("Enter a vocal rebalance amount between 0 and 1")}}
 settings.rebalance=amount
 vocal.validate(settings)
}
fn selected_outputs(selected:f64)->array<string> effects {alloc} {
 if selected==1.0{["vocals","instrumental"]}else{if selected==2.0{["bass","no_bass"]}else{
  if selected==3.0{["drums","no_drums"]}else{if selected==4.0{["other","no_other"]}else{[]}}}}
}
fn single_recipe(settings:str,checkpoint:str,selected:f64,method:f64,normalize:bool,keep:bool)->secondary_config.Recipe effects {alloc} {
 secondary_config.Recipe{models:[secondary_config.Model{config:string.copy(settings),checkpoint:string.copy(checkpoint)}],outputs:selected_outputs(selected),adjustments:[],
  complement:if method==1.0{"spectral"}else{"sum"},normalize:normalize,keep_members:keep}
}
fn secondary_recipe(state:ref<preferences.State>)->secondary_config.Recipe effects {alloc} {
 var copied:array<secondary_config.Model>=[]
 var i:u64=0
 loop{if i==array.len(state.ensemble_models){break}
  let model:ref<model_config.Model>=array.borrow(state.ensemble_models,i)
  array.push(copied,secondary_config.Model{config:string.copy(model.config),checkpoint:string.copy(model.checkpoint),definition:string.copy(model.definition)})
  i+=1}
 var adjustments:array<secondary_config.Adjustment>=[]
 i=0
 loop{if i==array.len(state.secondary_rules){break}
  let rule:ref<secondary_config.Adjustment>=array.borrow(state.secondary_rules,i)
  array.push(adjustments,secondary_config.Adjustment{target:string.copy(rule.target),model:rule.model,primary_weight:rule.primary_weight})
  i+=1}
 secondary_config.Recipe{models:copied,outputs:selected_outputs(state.secondary_outputs),adjustments:adjustments,normalize:state.secondary_normalize,keep_members:state.secondary_keep,complement:if state.secondary_spectral{"spectral"}else{if state.secondary_residual{"residual"}else{"sum"}},
  preprocess:state.preprocess_model,preprocess_complement:if state.preprocess_spectral{"spectral"}else{if state.preprocess_residual{"residual"}else{"direct"}},save_instrumental_mix:state.preprocess_extra,vocal_split:state.vocal_model,
  vocal_rebalance:if state.vocal_model>0{state.vocal_options.rebalance}else{0.0},vocal_mixes:state.vocal_model>0 and state.vocal_options.mixes,
  vocal_mix_only:state.vocal_model>0 and state.vocal_options.mix_only,vocal_save_only:state.vocal_model>0 and state.vocal_options.vocal_only}
}
fn add_model(models:ref<array<model_config.Model>>,settings:str,checkpoint:str,definition:str)->result<unit,string> effects {alloc,fs.read} {
 if str.len(settings)==0 or str.len(checkpoint)==0{return result.err("Choose a model configuration and weights first")}
 let key:string=try cache.checkpoint_id(checkpoint)
 var i:u64=0
 loop{if i==array.len(models){break}
  let previous:string=try cache.checkpoint_id(array.borrow(models,i).checkpoint)
  if key==previous{return result.err("That model is already in the ensemble")}
  i+=1}
 array.push(models,model_config.Model{config:string.copy(settings),checkpoint:string.copy(checkpoint),definition:string.copy(definition)})
 result.ok(())
}
fn reduction(index:f64)->string effects {alloc} {
 if index==1.0{"minimum"}else{if index==2.0{"maximum"}else{"average"}}
}
fn queue_list(app:ref<desk.Session>,items:ref<array<queue_config.Item>>,lists:ref<input_lists.State>)->unit effects {alloc,net,time} {
 input_lists.queued(app,struct.borrow(lists,field=queue),items)
}
fn queue_add(items:ref<array<queue_config.Item>>,index:u64,input:str)->bool effects {alloc} {
 if str.len(input)==0 or array.len(items)>=4096{return false}
 var i:u64=0
 loop{if i==array.len(items){break}
  if str.view(array.borrow(items,i).input)==input{return false}
  i+=1}
 array.push(items,queue_config.Item{input:string.copy(input),folder:queue_config.folder(index,input)})
 true
}
fn queue_pending(items:ref<array<queue_config.Item>>,report:ref<queue_config.Report>)->array<queue_config.Item> effects {alloc} {
 var pending:array<queue_config.Item>=[]
 var i:u64=0
 loop{if i==array.len(items){break}
  let original:ref<queue_config.Item>=array.borrow(items,i)
  var completed:bool=false
  var j:u64=0
  loop{if j==array.len(report.items){break}
   let outcome:ref<queue_config.Outcome>=array.borrow(report.items,j)
   if str.view(original.input)==str.view(outcome.input) and str.view(original.folder)==str.view(outcome.folder) and str.view(outcome.state)=="complete"{completed=true}
   j+=1}
  if not completed{array.push(pending,queue_config.Item{input:string.copy(original.input),folder:string.copy(original.folder)})}
  i+=1}
 pending
}
fn model_recipe(state:ref<preferences.State>)->model_config.Recipe effects {alloc} {
 var copied:array<model_config.Model>=[]
 var i:u64=0
 loop{if i==array.len(state.ensemble_models){break}
  let model:ref<model_config.Model>=array.borrow(state.ensemble_models,i)
  array.push(copied,model_config.Model{config:string.copy(model.config),checkpoint:string.copy(model.checkpoint),processing:string.copy(model.processing),definition:string.copy(model.definition)})
  i+=1}
 var outputs:array<model_config.Target>=[]
 if state.model_paired{
  array.push(outputs,model_config.Target{target:"vocals",method:reduction(state.model_primary),exclude:""})
  array.push(outputs,model_config.Target{target:"instrumental",method:reduction(state.model_secondary),exclude:""})}
 model_config.Recipe{models:copied,options:model_config.Options{outputs:outputs,method:reduction(state.model_primary),
  domain:if state.model_wave{"waveform"}else{"spectrum"},normalize:state.model_normalize,keep_members:state.model_keep,complement:if state.model_spectral{"spectral"}else{if state.model_residual{"residual"}else{"sum"}}}}
}
fn capture_models(state:ref<preferences.State>)->result<string,string> effects {alloc,fs.read,fs.meta} {
 if array.len(state.queue_items)==0{return result.ok("")}
 if str.len(state.queue_model_snapshot)>0{return result.ok(string.copy(state.queue_model_snapshot))}
 let ensemble:model_config.Recipe=model_recipe(state)
 let secondary:secondary_config.Recipe=secondary_recipe(state)
 model_snapshot.capture_selected(state.settings,state.checkpoint,
  try model_config.Recipe_encode(ensemble) map_err codec.describe,
  try secondary_config.Recipe_encode(secondary) map_err codec.describe,state.model_definition)
}
fn queue_append(state:ref<preferences.State>,input:str)->unit effects {alloc} {
 let index:u64=state.queue_index
 if queue_add(state.queue_items,index,input){state.queue_index+=1}
 ()
}
fn show_page(app:ref<desk.Session>,state:ref<preferences.State>,page:f64)->unit effects {alloc,net,time} {
 state.workflow_page=page
 let _=desk.set_number(app,"workflow","page",page)
 ()
}
