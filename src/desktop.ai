      continue}
     let recipe:alignment_choices.Recipe=match alignment_choices.from_full_indices(state.alignment_windows,state.alignment_intros,state.alignment_gain,state.alignment_phase,state.alignment_save_aligned,state.alignment_initial_polarity,state.alignment_match_silence,state.alignment_spectral_match){ok(value)=>value,err(e)=>{
