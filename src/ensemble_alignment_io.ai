module stemair.ensemble_alignment_io
import "ensemble_alignment_application.ai" as application
import "direct_alignment_io.ai" as direct
import "recording_alignment_application.ai" as base
import "alignment_choices.ai" as choices
import "checked_input.ai" as checked
import "container_export.ai" as container
import "alignment_thread_policy.ai" as threads
import "spectral_alignment_io.ai" as spectral
import "../toolkit/ensemble_alignment.ai" as core
import "../toolkit/recording_preparation.ai" as preparation
import "../toolkit/leading_silence.ai" as silence
import "../toolkit/control.ai" as control
import std.audio as audio
import std.codec as codec
import std.path as path
import std.cpu_dot as dot

type Intro=struct{divisor:u64,index:u64,left_lag:i64,right_lag:i64,unique_index:u64} derive codec(strict)
type Section=struct{start:u64,frames:u64,selected:u64} derive codec(strict)
type Coarse=struct{intro:u64,window_indices:array<u64>,window_sections:array<Section>} derive codec(strict)
type Automatic=struct{inverted:bool,coefficient_word:string,frames:u64} derive codec(strict)
type Silence=struct{frame:u64,channel:u64,energy_words:array<string>} derive codec(strict)
type Manifest=struct{operation:string,first:string,second:string,frames:u64,channels:u64,sample_rate:u32,
 windows:string,intros:string,gain:string,phase:string,inverted:bool,silence_delta:i64,
 initial_polarity:string,match_silence:bool,automatic:option<Automatic>,reference_silence:option<Silence>,target_silence:option<Silence>,
 intro_candidates:array<Intro>,coarse_candidates:array<Coarse>,coarse_indices:array<u64>,coarse_sections:array<Section>,local_windows:u64,
 residual:string,aligned:string,backend:string,checkpoint_loads:u64} derive codec(strict)

fn indices(values:view<u64>)->array<u64> effects {alloc} {
 var output:array<u64>=[]
 var i:u64=0
 loop{if i==view.len(values){break}
  array.push(output,view.get(values,i))
  i+=1}
 output
}
fn silence_observation(value:ref<option<silence.End>>)->result<option<Silence>,string> effects {alloc} {
 match value{none=>result.ok(option.none()),some(item)=>{
  var words:array<string>=[]
  var i:u64=0
  loop{if i==array.len(item.energies){break}
   let point:array<f32>=[array.get(item.energies,i)]
   let packed:dot.Buffer=try dot.pack(array.view(point))
   array.push(words,bytes.hex(bytes.view(packed.data)))
   i+=1}
  result.ok(option.some(Silence{frame:item.frame,channel:item.channel,energy_words:words}))}}
}
fn manifest(value:ref<core.Waves>,observed:ref<preparation.Observation>,recipe:ref<choices.Recipe>,first:str,second:str,plan:ref<container.Plan>)->result<Manifest,string> effects {alloc} {
 let automatic:option<Automatic>=match observed.automatic{none=>option.none(),some(item)=>{
  let point:array<f64>=[item.coefficient]
  let packed:dot.BufferF64=try dot.pack_f64(array.view(point))
  option.some(Automatic{inverted:item.inverted,coefficient_word:bytes.hex(bytes.view(packed.data)),frames:item.frames})}}
 let reference_silence:option<Silence>=try silence_observation(struct.borrow(observed,field=reference_silence))
 let target_silence:option<Silence>=try silence_observation(struct.borrow(observed,field=target_silence))
 var intros:array<Intro>=[]
 var coarses:array<Coarse>=[]
 var sections:array<Section>=[]
 var windows:u64=0
 var i:u64=0
 loop{if i==array.len(value.intros){break}
  let item:ref<core.Intro>=array.borrow(value.intros,i)
  array.push(intros,Intro{divisor:item.divisor,index:item.index,left_lag:item.left_lag,right_lag:item.right_lag,unique_index:item.unique_index})
  i+=1}
 i=0
 loop{if i==array.len(value.coarses){break}
  let item:ref<core.Coarse>=array.borrow(value.coarses,i)
  var parts:array<Section>=[]
  var w:u64=0
  loop{if w==array.len(item.parts){break}
   let part=array.borrow(item.parts,w)
   array.push(parts,Section{start:part.start,frames:part.frames,selected:part.selected})
   w+=1}
  w=0
  loop{if w==array.len(item.passes){break}
   windows+=array.borrow(item.passes,w).step_count
   w+=1}
  array.push(coarses,Coarse{intro:item.intro,window_indices:indices(array.view(item.window_indices)),window_sections:parts})
  i+=1}
 i=0
 loop{if i==array.len(value.parts){break}
  let part=array.borrow(value.parts,i)
  array.push(sections,Section{start:part.start,frames:part.frames,selected:part.selected})
  i+=1}
 result.ok(Manifest{operation:"recording-alignment",first:string.copy(first),second:string.copy(second),frames:value.frames,channels:value.channels,sample_rate:44100,
  windows:string.copy(recipe.windows),intros:string.copy(recipe.intros),gain:string.copy(recipe.gain),phase:string.copy(recipe.phase),inverted:observed.inverted,silence_delta:observed.silence_delta,
  initial_polarity:string.copy(recipe.initial_polarity),match_silence:recipe.match_silence,automatic:automatic,reference_silence:reference_silence,target_silence:target_silence,
  intro_candidates:intros,coarse_candidates:coarses,coarse_indices:indices(array.view(value.coarse_indices)),coarse_sections:sections,local_windows:windows,
  residual:container.filename("residual",plan),aligned:if recipe.save_aligned{container.filename("aligned",plan)}else{""},backend:"native-air-cpu",checkpoint_loads:0})
}
fn run_impl(settings:ref<application.Settings>,recipe:ref<choices.Recipe>,first:str,second:str,directory:str,cancel:str,progress:str,
 plan:ref<container.Plan>,log:ref<container.Journal>,options:ref<checked.Options>)->result<unit,string>
 effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 if control.cancelled(cancel){return result.err("Recording alignment cancelled")}
 if recipe.spectral_match{return spectral.run(settings,recipe,first,second,directory,cancel,progress,plan,log,options)}
 if recipe.windows=="none"{return direct.run(settings,recipe,first,second,directory,cancel,progress,plan,log,options)}
 let selection:choices.Selection=try choices.validate(recipe)
 let _=try base.validate(settings)
 let _=try container.verify(plan)
 let _=try container.require_directory(directory)
 let start:u64=array.len(log.artifacts)
 let _=try container.preflight_tracked(container.target(directory,"residual",plan),plan,log)
 if recipe.save_aligned{let _=try container.preflight_tracked(container.target(directory,"aligned",plan),plan,log)}
 let _=try container.preflight_metadata_tracked(path.join(directory,"recording-alignment.json"),log)
 let a:audio.AudioBuffer=try checked.buffer(first,44100,checked.queue_item(options,0,cancel))
 let b:audio.AudioBuffer=try checked.buffer(second,44100,checked.queue_item(options,1,cancel))
 var value:core.PreparedOutput=try application.compute_buffers_prepared(settings,a,b,selection.windows,selection.intros,selection.gain,selection.phase,selection.preparation,cancel,progress,false)
 if control.cancelled(cancel){return result.err("Recording alignment cancelled before export")}
 let report:Manifest=try manifest(struct.borrow(value,field=waves),struct.borrow(value,field=preparation),recipe,first,second,plan)
 let raw:string=try Manifest_encode(report) map_err codec.describe
 let waves:ref<core.Waves>=struct.borrow(value,field=waves)
 let residual:audio.AudioBuffer=audio.AudioBuffer{samples:struct.replace(waves,[],field=residual),rate:44100,channels:cast.wrap(waves.channels)}
 let _=try container.write_buffer(container.target(directory,"residual",plan),residual,plan,log,cancel,progress)
 if recipe.save_aligned{
  let aligned:audio.AudioBuffer=audio.AudioBuffer{samples:struct.replace(waves,[],field=aligned),rate:44100,channels:cast.wrap(waves.channels)}
  let _=try container.write_buffer(container.target(directory,"aligned",plan),aligned,plan,log,cancel,progress)}
 container.write_metadata(path.join(directory,"recording-alignment.json"),raw,plan,log,start)
}
pub fn run(settings:ref<application.Settings>,recipe:ref<choices.Recipe>,first:str,second:str,directory:str,cancel:str,progress:str,
 plan:ref<container.Plan>,log:ref<container.Journal>,options:ref<checked.Options>)->result<unit,string>
 effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 let _=try run_guarded(settings,recipe,first,second,directory,cancel,progress,plan,log,options) map_err threads.describe
 result.ok(())
}
pub fn run_guarded(settings:ref<application.Settings>,recipe:ref<choices.Recipe>,first:str,second:str,directory:str,cancel:str,progress:str,
 plan:ref<container.Plan>,log:ref<container.Journal>,options:ref<checked.Options>)->result<unit,threads.Failure>
 effects {alloc,fs.read,fs.write,fs.meta,ffi,process,time} {
 log.attempted=""
 log.failure=""
 if control.cancelled(cancel){return result.err(threads.failure("Recording alignment cancelled"))}
 let _=try choices.validate_any(recipe) map_err threads.failure
 if recipe.windows=="none"{let _=try direct.validate(settings) map_err threads.failure}else{let _=try base.validate(settings) map_err threads.failure}
 let lease:threads.Lease=try threads.begin(settings.dot_runtime,settings.dot_sha256)
 let outcome:result<unit,string>=run_impl(settings,recipe,first,second,directory,cancel,progress,plan,log,options)
 match threads.finish(lease,outcome){ok(value)=>result.ok(value),err(problem)=>{
  if str.len(log.failure)==0{container.record_failure(log,"",problem.message)}
  result.err(problem)}}
}
