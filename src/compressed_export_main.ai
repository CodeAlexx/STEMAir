module stemair.compressed_export_main
import "../toolkit/compressed_export.ai" as export
import std.audio as audio
import std.files as files
import std.codec as codec
fn failure(error:files.ReadError)->string effects {alloc} {match error{Io(e)=>string.copy(fs.error.message(e)),TooLarge=>"Audio export input exceeds its byte bound"}}
fn run(args:view<str>)->result<string,string> effects {alloc,fs.read,fs.write,fs.meta,process,time} {
 let recipe:bytes=try files.read_limited(view.get(args,1),16384) map_err failure
 let text:str=match str.from_bytes(bytes.view(recipe)){some(v)=>v,none=>{return result.err("Export recipe must be UTF-8")}}
 let settings:export.Settings=try export.Settings_decode(text) map_err codec.describe
 let input:bytes=try files.read_limited(view.get(args,2),67112960) map_err failure
 let _=try audio.inspect_wav(bytes.view(input)) map_err audio.message
 let source:audio.AudioBuffer=try audio.decode_wav(bytes.view(input)) map_err audio.message
 let cancel:string=if view.len(args)>=5{string.copy(view.get(args,4))}else{""}
 let progress:string=if view.len(args)>=6{string.copy(view.get(args,5))}else{""}
 let report:export.Report=try export.run(source,settings,view.get(args,3),cancel,progress)
 result.ok(try export.Report_encode(report) map_err codec.describe)
}
pub fn main(args:view<str>)->i32 effects {alloc,fs.read,fs.write,fs.meta,process,time,io.write} {
 if view.len(args)<4 or view.len(args)>6{io.ewrite("Usage: stem-export-codec SETTINGS.json INPUT.wav OUTPUT [CANCEL_FILE] [PROGRESS_FILE]\n")
  return 2}
 match run(args){ok(report)=>{io.write(report)
  io.write("\n")
  0},err(problem)=>{io.ewrite(problem)
  io.ewrite("\n")
  1}}
}
