module stemair.alignment_main
import "alignment_application.ai" as app
pub fn main(args:view<str>)->i32 effects {alloc, ffi, fs.meta, fs.read, fs.write, io.write, process, time} {
 if view.len(args)<5 or view.len(args)>7{io.ewrite("Use stem-align RECIPE.json FIRST.wav SECOND.wav OUTPUT_DIRECTORY [CANCEL_FILE] [PROGRESS_FILE]\n")
  return 2}
 let settings:app.Settings=match app.read(view.get(args,1)){ok(v)=>v,err(e)=>{io.ewrite(e)
  return 1}}
 let cancel:string=if view.len(args)>=6{string.copy(view.get(args,5))}else{""}
 let progress:string=if view.len(args)>=7{string.copy(view.get(args,6))}else{""}
 match app.run(settings,view.get(args,2),view.get(args,3),view.get(args,4),cancel,progress){ok(_)=>{io.write("Coarse alignment complete\n")
  0},err(e)=>{io.ewrite(e)
  io.ewrite("\n")
  1}}
}
