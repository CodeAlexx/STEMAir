module stemair.paired_list_panel
import "../../AIR/toolkits/desktop/ui.ai" as desk
import "input_selection.ai" as selection
import "../toolkit/paired_inputs.ai" as ordered
import std.codec as codec
import std.text as text

pub fn items(app:ref<desk.Session>,id:str,inputs:ref<array<string>>,state:ref<selection.State>)->unit effects {alloc,net,time} {
 var out:codec.Writer=desk.command("items",id)
 codec.key(out,"items")
 codec.begin_array(out)
 var i:u64=0
 loop{if i==array.len(inputs){break}
  codec.begin_object(out)
  codec.field_text(out,"key",selection.key(state,i))
  codec.field_text(out,"label",text.concat(string.from_int(i+1),text.concat(". ",array.get(inputs,i))))
  codec.field_text(out,"icon","audio-x-generic-symbolic")
  codec.end_object(out)
  i+=1}
 codec.end_array(out)
 let _=desk.submit(app,out)
 if array.len(state.selected)==1{
  let index:u64=array.get(state.selected,0)
  if index<array.len(inputs){let _=desk.select(app,id,selection.key(state,index))}}
 ()
}
pub fn summary(first:ref<array<string>>,second:ref<array<string>>)->result<string,string> effects {alloc} {
 let pairing:ordered.Pairing=try ordered.pair(first,second)
 result.ok(text.concat(string.from_int(array.len(pairing.items)),text.concat(" pairs; unmatched first: ",text.concat(string.from_int(pairing.unmatched_first),text.concat("; unmatched second: ",string.from_int(pairing.unmatched_second))))))
}
pub fn show(app:ref<desk.Session>,first:ref<array<string>>,second:ref<array<string>>,first_selection:ref<selection.State>,second_selection:ref<selection.State>)->unit effects {alloc,net,time} {
 items(app,"pairs_first_rows",first,first_selection)
 items(app,"pairs_second_rows",second,second_selection)
 let status:string=match summary(first,second){ok(value)=>value,err(error)=>error}
 let _=desk.set_text(app,"pairs_counts",status)
 ()
}
