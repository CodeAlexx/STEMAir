module stemair.residual_waveform.session
import "network.ai" as network
import "device.ai" as device
import "host.ai" as cpu
import "config.ai" as config
import "../hybrid/host_prepared.ai" as prepared
import "../hybrid/host_ops.ai" as host_ops
import "../host_recording_audio.ai" as host_recording
import "../recording_audio.ai" as recording
import "../recording_moments.ai" as moments
import "../audio_normalization.ai" as normalization
import "../recording_shifts.ai" as shifts
import "../ops.ai" as ops
import std.tensor as tensor
import std.mkl_vml as vml

pub type Cpu=struct{backend:prepared.Backend,requests:u64=0,forward_calls:u64=0}
pub type Session=struct{network:network.Network,cpu:array<Cpu>,gpu:array<device.State>,cpu_preparations:u64=0,requests:u64=0}
pub fn open(path:str,c:ref<config.Config>)->result<Session,string> effects {alloc,fs.read}{
 let _=try config.validate(c)
 let n:network.Network=try if c.packed{network.open_packed(path)}else{network.open(path)}
 result.ok(Session{network:n,cpu:[],gpu:[]})
}
pub fn prepare_cpu(s:ref<Session>)->result<unit,string> effects {alloc,fs.read}{
 if array.len(s.cpu)==0{array.push(s.cpu,Cpu{backend:try cpu.prepare(struct.borrow(s,field=network))})
  s.cpu_preparations+=1}
 if array.len(s.cpu)!=1{return result.err("Residual waveform requires one CPU weight bank")}
 result.ok(())
}
fn cpu_predict(n:ref<network.Network>,p:ref<Cpu>,library:ref<CAbiLibrary>,input:ref<ops.Tensor>,cancel:str)->result<ops.Tensor,string> effects {alloc,ffi,fs.meta}{
 var out:host_ops.Tensor=try cpu.forward(n,struct.borrow(p,field=backend),library,array.view(input.data),cancel)
 p.forward_calls+=1
 result.ok(ops.Tensor{c:out.c,h:out.h,w:out.w,data:struct.replace(out,[],field=data)})
}
fn cpu_length(n:ref<network.Network>,length:u64)->result<u64,string> effects {alloc}{
 network.valid_length(struct.borrow(n.constructor,field=kwargs),length)
}
pub fn segment(s:ref<Session>,c:ref<config.Config>)->u64 effects {} {
 if c.segment_samples!=0{c.segment_samples}else{cast.sat(s.network.constructor.kwargs.segment*44100.0)}
}
pub fn separate_cpu(s:ref<Session>,library:ref<CAbiLibrary>,c:ref<config.Config>,input:view<f32>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,ffi,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.cpu)!=1{return result.err("Residual waveform CPU weights were not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try host_recording.separate<network.Network,Cpu,config.Config>(struct.borrow(s,field=network),array.borrow(s.cpu,0),library,c,size,input,cancel,progress,cpu_predict,cpu_length)
 let bank:ref<Cpu>=array.borrow(s.cpu,0)
 bank.requests+=1
 s.requests+=1
 result.ok(out)
}
pub fn separate_cpu_scheduled(s:ref<Session>,library:ref<CAbiLibrary>,c:ref<config.Config>,schedule:ref<shifts.Schedule>,input:view<f32>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,ffi,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.cpu)!=1{return result.err("Residual waveform CPU weights were not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try host_recording.separate_scheduled<network.Network,Cpu,config.Config>(struct.borrow(s,field=network),array.borrow(s.cpu,0),library,c,schedule,size,input,cancel,progress,cpu_predict,cpu_length)
 let bank:ref<Cpu>=array.borrow(s.cpu,0)
 bank.requests+=1
 s.requests+=1
 result.ok(out)
}
fn gpu_predict(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,input:ref<tensor.Tensor>,cancel:str)->result<ops.Tensor,string> effects {alloc,gpu,fs.meta}{
 if array.len(s.gpu)!=1{return result.err("Residual waveform GPU work was not prepared")}
 device.forward(context,stream,parameters,struct.borrow(s,field=network),array.borrow(s.gpu,0),input,cancel)
}
fn gpu_length(s:ref<Session>,length:u64)->result<u64,string> effects {alloc}{
 network.valid_length(struct.borrow(s.network.constructor,field=kwargs),length)
}
pub fn separate(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,c:ref<config.Config>,input:view<f32>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,gpu,fs.meta,fs.write}{
 let _=try config.validate(c)
 let size:u64=segment(s,c)
 let out:array<f32>=try recording.separate_prepared(context,stream,parameters,s,c,size,try moments.prepare(input,2),cancel,progress,gpu_predict,gpu_length)
 s.requests+=1
 result.ok(out)
}
pub fn separate_scheduled(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,c:ref<config.Config>,schedule:ref<shifts.Schedule>,input:view<f32>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,gpu,fs.meta,fs.write}{
 let _=try config.validate(c)
 let size:u64=segment(s,c)
 let out:array<f32>=try recording.separate_prepared_scheduled(context,stream,parameters,s,c,schedule,size,try moments.prepare(input,2),cancel,progress,gpu_predict,gpu_length)
 s.requests+=1
 result.ok(out)
}
pub fn prepare_gpu(context:ref<GpuContext>,stream:ref<GpuStream>,s:ref<Session>,runtime:ref<vml.Vml>)->result<unit,string> effects {alloc,ffi,gpu}{
 if array.len(s.gpu)!=0{return result.err("Previous residual waveform GPU work was not released")}
 array.push(s.gpu,try device.prepare(context,stream,struct.borrow(s,field=network),runtime,device.Limits{}))
 result.ok(())
}
pub fn separate_once(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,c:ref<config.Config>,input:view<f32>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,env,ffi,gpu,fs.meta,fs.write}{
 var math:vml.Vml=try vml.open_default()
 let _=try prepare_gpu(context,stream,s,math)
 let out:result<array<f32>,string>=separate(context,stream,parameters,s,c,input,cancel,progress)
 s.gpu=[]
 out
}

// Raw normalized source order for one weighted bag member.
pub fn separate_normalized_cpu(s:ref<Session>,library:ref<CAbiLibrary>,c:ref<config.Config>,preparation:normalization.Prepared own,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,ffi,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.cpu)!=1{return result.err("Residual waveform CPU weights were not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try host_recording.separate_normalized_sources<network.Network,Cpu,config.Config>(struct.borrow(s,field=network),array.borrow(s.cpu,0),library,c,size,4,preparation,cancel,progress,cpu_predict,cpu_length)
 let bank:ref<Cpu>=array.borrow(s.cpu,0)
 bank.requests+=1
 s.requests+=1
 result.ok(out)
}

// Raw normalized source order for one weighted bag member.
pub fn separate_normalized_cpu_group(s:ref<Session>,library:ref<CAbiLibrary>,c:ref<config.Config>,schedule:ref<shifts.Schedule>,preparation:normalization.Prepared own,group:ref<shifts.Group>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,ffi,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.cpu)!=1{return result.err("Residual waveform CPU weights were not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try host_recording.separate_normalized_group_sources<network.Network,Cpu,config.Config>(struct.borrow(s,field=network),array.borrow(s.cpu,0),library,c,schedule,size,4,preparation,group,cancel,progress,cpu_predict,cpu_length)
 let bank:ref<Cpu>=array.borrow(s.cpu,0)
 bank.requests+=1
 s.requests+=1
 result.ok(out)
}

// Raw normalized source order for one weighted bag member.
pub fn separate_normalized(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,c:ref<config.Config>,preparation:normalization.Prepared own,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,gpu,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.gpu)!=1{return result.err("Residual waveform GPU work was not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try recording.separate_normalized_sources(context,stream,parameters,s,c,size,4,preparation,cancel,progress,gpu_predict,gpu_length)
 s.requests+=1
 result.ok(out)
}

// Raw normalized source order for one weighted bag member.
pub fn separate_normalized_group(context:ref<GpuContext>,stream:ref<GpuStream>,parameters:ref<array<tensor.Tensor>>,s:ref<Session>,c:ref<config.Config>,schedule:ref<shifts.Schedule>,preparation:normalization.Prepared own,group:ref<shifts.Group>,cancel:str,progress:str)->result<array<f32>,string> effects {alloc,gpu,fs.meta,fs.write}{
 let _=try config.validate(c)
 if array.len(s.gpu)!=1{return result.err("Residual waveform GPU work was not prepared")}
 let size:u64=segment(s,c)
 let out:array<f32>=try recording.separate_normalized_group_sources(context,stream,parameters,s,c,schedule,size,4,preparation,group,cancel,progress,gpu_predict,gpu_length)
 s.requests+=1
 result.ok(out)
}
