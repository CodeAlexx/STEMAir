module stemair.inference_pitch_cpu
import "model_cache.ai" as cache
import "recording_context.ai" as context
import "mask/request.ai" as request
import "audio_result.ai" as audio
import "inference_pitch.ai" as pitch
import "inference_pitch_output.ai" as output
import "exchange/config.ai" as config
import "exchange/audio.ai" as envelope
import "exchange/host_session.ai" as host
import "exchange/host_prepared_session.ai" as prepared_host
import "spectral.ai" as spectral
import "exchange/frequency_match.ai" as frequency
import "engine.ai" as engine
import std.codec as codec
import std.cpu_dot as dot

type Prediction=struct{samples:audio.Samples,frequency_reference:array<f32>}
fn exchange(model:ref<engine.Loaded>,runtimes:ref<array<dot.Engine>>,values:view<f32>,prepared:ref<pitch.Prepared>,input:view<f32>,cancel:str,progress:str)->result<Prediction,string> effects {alloc,ffi,fs.meta,fs.write}{
 var settings:config.Config=try config.Config_decode(model.profile.identity) map_err codec.describe
 let _=try config.validate_typed(settings)
 var transform:spectral.Plan=spectral.plan(settings.n_fft,settings.hop,spectral.hann(settings.n_fft))
 match model.exchange{none=>{return result.err("Pitched interchange session is unavailable")},some(value)=>{
  var state:envelope.State=if array.len(value.cpu)==1{
   if array.len(runtimes)!=1{return result.err("Pitched CPU model has no retained runtime")}
   try prepared_host.separate_state(struct.borrow(value,field=graph),array.borrow(value.cpu,0),struct.borrow(array.borrow(runtimes,0),field=library),transform,settings,values,cancel,progress)
  }else{try host.separate_state(struct.borrow(value,field=graph),transform,settings,values,cancel,progress)}
  let result:audio.Samples=try output.exchange(state,prepared,input,settings.compensation)
  var reference:array<f32>=[]
  if prepared.settings.match_frequency{
   let matched:array<f32>=try pitch.matched_mix(input,prepared.settings)
   let primary:str=array.get(settings.targets,0)
   reference=if primary=="vocals" or primary=="instrumental"{try frequency.cpu(settings,array.view(matched),cancel,progress)}else{matched}}
  model.requests+=1
  result.ok(Prediction{samples:result,frequency_reference:reference})}}
}

pub fn separate(bank:ref<cache.Cache>,index:u64,input:view<f32>,cancel:str,progress:str,policy:ref<request.Policy>,controls:ref<context.Context>,lower:view<f32>,predict:fn(ref<cache.Cache>,u64,view<f32>,str,str,ref<request.Policy>,ref<context.Context>,view<f32>)->result<audio.Samples,string> effects {alloc,ffi,fs.meta,fs.write})->result<audio.Samples,string> effects {alloc,ffi,fs.meta,fs.write}{
 controls.frequency_reference=[]
 let _=try request.validate_policy(policy)
 let _=try cache.require_cpu_policy(bank)
 if index>=array.len(bank.entries){return result.err("Pitched model index is out of range")}
 let kind:string=string.copy(array.borrow(bank.entries,index).model.profile.kind)
 if (not controls.pitch.enabled and not controls.pitch.match_frequency) or not output.supported(kind){return predict(bank,index,input,cancel,progress,policy,controls,lower)}
 if view.len(lower)>0{return result.err("Lower-band input is only valid for mask inference")}
 var prepared:pitch.Prepared=try pitch.prepare(input,controls.pitch)
 let values:array<f32>=struct.replace(prepared,[],field=values)
 if kind=="exchange"{
  var result:Prediction=try exchange(struct.borrow(array.borrow(bank.entries,index),field=model),struct.borrow(bank,field=cpu),array.view(values),prepared,input,cancel,progress)
  controls.frequency_reference=struct.replace(result,[],field=frequency_reference)
  return result.ok(struct.replace(result,audio.from_single([]),field=samples))}
 let sources:u64=array.len(array.borrow(bank.entries,index).model.profile.targets)
 var result:audio.Samples=try predict(bank,index,array.view(values),cancel,progress,policy,controls,[])
 if result.precision!=audio.Precision.Float32{return result.err("Recording pitch requires the model's Float32 output")}
 let restored:array<f32>=try pitch.finish_sources(array.view(result.single),sources,prepared)
 if kind=="spectral" and controls.pitch.match_frequency and controls.pitch.enabled and controls.pitch.semitones!=0.0{controls.frequency_reference=try pitch.matched_mix(input,controls.pitch)}
 result.ok(audio.from_single(restored))
}
