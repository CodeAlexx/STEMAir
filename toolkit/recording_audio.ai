   var time:u64=0
   loop{if time==length{break}
    let at:u64=channel*length+time
    array.set(averaged,at,array.get(averaged,at)+array.get(raw,channel*count+half-offset+time))
    time+=1}
   channel+=1}
  shift+=1}
 let divisor:f32=cast.float(group.divisor)
 var i:u64=0
 loop{if i==array.len(averaged){break}
  array.set(averaged,i,array.get(averaged,i)/divisor)
  i+=1}
