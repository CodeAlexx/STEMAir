module stemair.spatial
import "ops.ai" as ops

// Materialized single-batch CHW spatial operations. These layout operations are
// independent of model weights, paths, providers and application scheduling.
pub fn resize_corners(x:ref<ops.Tensor>,height:u64,width:u64)->result<ops.Tensor,string> effects {alloc} {
 if height==0 or width==0 or height>65536 or width>65536 or x.c>268435456/height/width{
  return result.err("Invalid bilinear resize extent")}
 let sy:f32=if height>1{cast.float(x.h-1)/cast.float(height-1)}else{0.0}
 let sx:f32=if width>1{cast.float(x.w-1)/cast.float(width-1)}else{0.0}
 var out:array<f32>=[]
 array.reserve(out,x.c*height*width)
 var c:u64=0
 loop{if c>=x.c{break}
  var y:u64=0
  loop{if y>=height{break}
   let fy:f32=sy*cast.float(y)
   let y0:u64=cast.sat(fy)
   let y1:u64=if y0+1<x.h{y0+1}else{y0}
   let hy1:f32=fy-cast.float(y0)
   let hy0:f32=1.0-hy1
   var z:u64=0
   loop{if z>=width{break}
    let fx:f32=sx*cast.float(z)
    let x0:u64=cast.sat(fx)
    let x1:u64=if x0+1<x.w{x0+1}else{x0}
    let wx1:f32=fx-cast.float(x0)
    let wx0:f32=1.0-wx1
    let a:f32=array.get(x.data,(c*x.h+y0)*x.w+x0)
    let b:f32=array.get(x.data,(c*x.h+y0)*x.w+x1)
    let d:f32=array.get(x.data,(c*x.h+y1)*x.w+x0)
    let e:f32=array.get(x.data,(c*x.h+y1)*x.w+x1)
    array.push(out,hy0*(wx0*a+wx1*b)+hy1*(wx0*d+wx1*e))
    z+=1}
   y+=1}
  c+=1}
 result.ok(ops.tensor(x.c,height,width,out))
}
pub fn mean_height(x:ref<ops.Tensor>)->ops.Tensor effects {alloc} {
 var out:array<f32>=[]
 array.reserve(out,x.c*x.w)
 var c:u64=0
 loop{if c>=x.c{break}
  var t:u64=0
  loop{if t>=x.w{break}
   var sum:f32=0.0
   var f:u64=0
   loop{if f>=x.h{break}
    sum+=array.get(x.data,(c*x.h+f)*x.w+t)
    f+=1}
   array.push(out,sum/cast.float(x.h))
   t+=1}
  c+=1}
 ops.tensor(x.c,1,x.w,out)
}
pub fn slice(x:ref<ops.Tensor>,first_h:u64,height:u64,first_w:u64,width:u64)->result<ops.Tensor,string> effects {alloc} {
 if height==0 or width==0 or first_h>x.h or height>x.h-first_h or first_w>x.w or width>x.w-first_w{
  return result.err("Spatial slice lies outside its input")}
 var out:array<f32>=[]
 array.reserve(out,x.c*height*width)
 var c:u64=0
 loop{if c>=x.c{break}
  var h:u64=0
  loop{if h>=height{break}
   var w:u64=0
   loop{if w>=width{break}
    array.push(out,array.get(x.data,(c*x.h+first_h+h)*x.w+first_w+w))
    w+=1}
   h+=1}
  c+=1}
 result.ok(ops.tensor(x.c,height,width,out))
}
pub fn concatenate_height(a:ref<ops.Tensor>,b:ref<ops.Tensor>)->result<ops.Tensor,string> effects {alloc} {
 if a.c!=b.c or a.w!=b.w{return result.err("Height concatenation shape mismatch")}
 var out:array<f32>=[]
 array.reserve(out,a.c*(a.h+b.h)*a.w)
 var c:u64=0
 loop{if c>=a.c{break}
  var i:u64=0
  loop{if i>=a.h*a.w{break}
   array.push(out,array.get(a.data,c*a.h*a.w+i))
   i+=1}
  i=0
  loop{if i>=b.h*b.w{break}
   array.push(out,array.get(b.data,c*b.h*b.w+i))
   i+=1}
  c+=1}
 result.ok(ops.tensor(a.c,a.h+b.h,a.w,out))
}
