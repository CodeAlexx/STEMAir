module stemair.model_ensemble_config
import std.codec as codec

pub type Target=struct{target:string,method:string="",exclude:string=""} derive codec(strict)
pub type Options=struct{outputs:array<Target>,method:string="average",domain:string="spectrum",
 normalize:bool=false,keep_members:bool=false,complement:string="sum"} derive codec(strict)
pub type Model=struct{config:string,checkpoint:string,processing:string="",definition:string=""}
type LegacyModel=struct{config:string,checkpoint:string,processing:string=""} derive codec(strict)
type WireModel=struct{config:string,checkpoint:string,processing:string="",definition:string=""} derive codec(strict)
pub type Recipe=struct{models:array<Model>,options:Options}
type LegacyRecipe=struct{models:array<LegacyModel>,options:Options} derive codec(strict)
type WireRecipe=struct{models:array<WireModel>,options:Options} derive codec(strict)
pub type ModelRecord=struct{config:string,checkpoint:string,engine:string,profile:string,parameter_tensors:u64,
 checkpoint_loads:u64,bytes_read:u64,inference_requests:u64} derive codec(strict)
pub type Manifest=struct{input:string,sample_rate:u32,frames:u64,options:Options,models:array<ModelRecord>,backend:string} derive codec(strict)
pub type SpectralManifest=struct{input:string,sample_rate:u32,frames:u64,frame_counts:array<u64>,options:Options,models:array<ModelRecord>,backend:string} derive codec(strict)
pub type ProcessingBinding=struct{model:u64,loaded_model:u64} derive codec(strict)
pub type ProcessingMember=struct{recipe:string,bindings:array<ProcessingBinding>} derive codec(strict)
pub type ProcessingManifest=struct{input:string,sample_rate:u32,frames:u64,frame_counts:array<u64>,options:Options,models:array<ModelRecord>,members:array<ProcessingMember>,backend:string} derive codec(strict)

// Empty/default editor metadata deliberately retains the original serialized bytes.
pub fn Model_decode(raw:str)->result<Model,codec.Error> effects {alloc} {
 var value:WireModel=try WireModel_decode(raw)
 result.ok(Model{config:string.copy(value.config),checkpoint:string.copy(value.checkpoint),processing:string.copy(value.processing),definition:string.copy(value.definition)})
}
pub fn Model_encode(value:ref<Model>)->result<string,codec.Error> effects {alloc} {
 if str.len(value.definition)>0{var encoded:WireModel=WireModel{config:string.copy(value.config),checkpoint:string.copy(value.checkpoint),processing:string.copy(value.processing),definition:string.copy(value.definition)}
  return WireModel_encode(encoded)}
 var encoded:LegacyModel=LegacyModel{config:string.copy(value.config),checkpoint:string.copy(value.checkpoint),processing:string.copy(value.processing)}
 LegacyModel_encode(encoded)
}
pub fn Recipe_decode(raw:str)->result<Recipe,codec.Error> effects {alloc} {
 var value:WireRecipe=try WireRecipe_decode(raw)
 var models:array<Model>=[]
 var i:u64=0
 loop{if i==array.len(value.models){break}
  let item:ref<WireModel>=array.borrow(value.models,i)
  array.push(models,Model{config:string.copy(item.config),checkpoint:string.copy(item.checkpoint),processing:string.copy(item.processing),definition:string.copy(item.definition)})
  i+=1}
 result.ok(Recipe{models:models,options:struct.replace(value,Options{outputs:[]},field=options)})
}
pub fn Recipe_encode(source:ref<Recipe>)->result<string,codec.Error> effects {alloc} {
 var extended:bool=false
 var i:u64=0
 loop{if i==array.len(source.models){break}
  let value:ref<Model>=array.borrow(source.models,i)
  if str.len(value.definition)>0{extended=true}
  i+=1}
 if extended{
 var models:array<WireModel>=[]
 i=0
 loop{if i==array.len(source.models){break}
  let item:ref<Model>=array.borrow(source.models,i)
  array.push(models,WireModel{config:string.copy(item.config),checkpoint:string.copy(item.checkpoint),processing:string.copy(item.processing),definition:string.copy(item.definition)})
  i+=1}
  var encoded:WireRecipe=WireRecipe{models:models,options:(try Options_decode(try Options_encode(struct.borrow(source,field=options))))}
  return WireRecipe_encode(encoded)
 }
  var models:array<LegacyModel>=[]
 i=0
 loop{if i==array.len(source.models){break}
  let item:ref<Model>=array.borrow(source.models,i)
  array.push(models,LegacyModel{config:string.copy(item.config),checkpoint:string.copy(item.checkpoint),processing:string.copy(item.processing)})
  i+=1}
 var encoded:LegacyRecipe=LegacyRecipe{models:models,options:(try Options_decode(try Options_encode(struct.borrow(source,field=options))))}
 LegacyRecipe_encode(encoded)
}
